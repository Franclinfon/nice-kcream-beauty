{% extends 'front/base.html.twig' %}

{% block title %}Mon panier — Nice K'Cream Beauty{% endblock %}

{% block content %}
<div class="container py-5">
    <h1 class="mb-4" style="font-family: var(--font-titre);">Mon panier</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% if cartItems|length > 0 %}
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Article</th>
                                <th>Prix unitaire</th>
                                <th>Quantité</th>
                                <th>Sous-total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in cartItems %}
                            <tr>
                                <td>
                                    {% if item.type == 'coffret' %}
                                        {# Coffret #}
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="{{ asset('images/coffret.png') }}"
                                                 style="width:60px; height:60px; object-fit:cover; border-radius:6px;"
                                                 alt="{{ item.coffret.nom }}">
                                            <div>
                                                <span class="fw-600">{{ item.coffret.nom }}</span>
                                                <br>
                                                <span class="badge" style="background:var(--rose-pale); color:var(--rose); font-size:0.65rem; font-weight:700; letter-spacing:1px;">COFFRET</span>
                                            </div>
                                        </div>
                                    {% else %}
                                        {# Produit #}
                                        <div class="d-flex align-items-center gap-3">
                                            {% if item.product.mainImage %}
                                                <img src="{{ asset('uploads/products/' ~ item.product.mainImage.filename) }}"
                                                     style="width:60px; height:60px; object-fit:cover; border-radius:6px; background:#f8f8f8;"
                                                     alt="{{ item.product.nom }}">
                                            {% else %}
                                                <div style="width:60px; height:60px; background:var(--rose-pale); border-radius:6px; display:flex; align-items:center; justify-content:center;">
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                                                </div>
                                            {% endif %}
                                            <span>{{ item.product.nom }}</span>
                                        </div>
                                    {% endif %}
                                </td>

                                <td>
                                    {% if item.type == 'coffret' %}
                                        {{ item.coffret.prix|number_format(2, ',', ' ') }} €
                                    {% else %}
                                        {{ (item.product.prixPromo ?? item.product.prix)|number_format(2, ',', ' ') }} €
                                    {% endif %}
                                </td>

                                <td style="width:140px;">
                                    {% if item.type == 'coffret' %}
                                        <form action="{{ path('app_front_coffret_cart_update', {id: item.coffret.id}) }}" method="post" class="d-flex gap-2">
                                            <input type="number" name="quantity" value="{{ item.quantity }}" min="1" class="form-control form-control-sm" style="width:70px;">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">OK</button>
                                        </form>
                                    {% else %}
                                        <form action="{{ path('app_front_cart_update', {id: item.product.id}) }}" method="post" class="d-flex gap-2">
                                            <input type="number" name="quantity" value="{{ item.quantity }}" min="1" class="form-control form-control-sm" style="width:70px;">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">OK</button>
                                        </form>
                                    {% endif %}
                                </td>

                                <td class="fw-bold" style="color:var(--rose);">
                                    {{ item.subtotal|number_format(2, ',', ' ') }} €
                                </td>

                                <td>
                                    {% if item.type == 'coffret' %}
                                        <form action="{{ path('app_front_coffret_cart_remove', {id: item.coffret.id}) }}" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                        </form>
                                    {% else %}
                                        <form action="{{ path('app_front_cart_remove', {id: item.product.id}) }}" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {# Récapitulatif #}
            <div class="col-lg-4">
                <div style="background:white; border-radius:12px; padding:1.5rem; box-shadow:var(--shadow);">
                    <h5 style="font-family:var(--font-titre); margin-bottom:1.25rem; padding-bottom:0.75rem; border-bottom:2px solid var(--rose-pale);">Récapitulatif</h5>

                    {% for item in cartItems %}
                    <div class="d-flex justify-content-between align-items-center mb-2" style="font-size:0.85rem;">
                        <span style="color:var(--gris);">
                            {% if item.type == 'coffret' %}
                                {{ item.coffret.nom }} × {{ item.quantity }}
                            {% else %}
                                {{ item.product.nom }} × {{ item.quantity }}
                            {% endif %}
                        </span>
                        <span>{{ item.subtotal|number_format(2, ',', ' ') }} €</span>
                    </div>
                    {% endfor %}

                    <hr style="border-color:var(--rose-pale);">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span style="font-weight:700;">Total</span>
                        <span style="font-size:1.3rem; font-weight:700; color:var(--rose);">{{ total|number_format(2, ',', ' ') }} €</span>
                    </div>

                    <a href="{{ path('app_front_checkout_address') }}" class="btn btn-pink w-100 mb-2" style="padding:0.75rem;">
                        Passer la commande
                    </a>
                    <a href="{{ path('app_front_product_index') }}" class="btn btn-outline-dark w-100" style="padding:0.75rem; font-size:0.85rem;">
                        Continuer mes achats
                    </a>
                </div>
            </div>
        </div>

    {% else %}
        <div class="text-center py-5">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1" style="opacity:0.3; margin-bottom:1.5rem;"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            <h3 style="font-family:var(--font-titre); color:var(--noir);">Votre panier est vide</h3>
            <p class="text-muted mb-4">Découvrez nos produits et coffrets K-Beauty.</p>
            <div class="d-flex gap-3 justify-content-center">
                <a href="{{ path('app_front_product_index') }}" class="btn btn-pink">Voir la boutique</a>
                <a href="{{ path('app_front_coffret_index') }}" class="btn btn-outline-rose">Voir les coffrets</a>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}