{% extends 'front/base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<style>
    .legal-hero {
        background-color: var(--rose-pale);
        padding: 3rem 0 2rem;
        text-align: center;
    }
    .legal-hero h1 {
        font-family: var(--font-titre);
        font-size: 2rem;
        font-weight: 600;
        color: var(--noir);
        margin-bottom: 0.5rem;
    }
    .legal-hero p {
        color: var(--gris);
        font-size: 0.85rem;
    }
    .legal-body {
        max-width: 820px;
        margin: 0 auto;
        padding: 3rem 1rem 4rem;
    }
    .legal-body h2 {
        font-family: var(--font-titre);
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--noir);
        margin-top: 2.5rem;
        margin-bottom: 0.75rem;
        padding-bottom: 0.4rem;
        border-bottom: 2px solid var(--rose-pale);
    }
    .legal-body h3 {
        font-family: var(--font-corps);
        font-size: 1rem;
        font-weight: 600;
        color: var(--rose);
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
    }
    .legal-body p, .legal-body li {
        font-size: 0.9rem;
        line-height: 1.8;
        color: #374151;
    }
    .legal-body ul {
        padding-left: 1.5rem;
        margin-bottom: 1rem;
    }
    .legal-body a {
        color: var(--rose);
        text-decoration: none;
    }
    .legal-body a:hover { text-decoration: underline; }
    .legal-update {
        background: var(--rose-pale);
        border-radius: 6px;
        padding: 0.75rem 1rem;
        font-size: 0.8rem;
        color: var(--gris);
        margin-bottom: 2rem;
        display: inline-block;
    }
    .legal-nav {
        background: var(--blanc);
        border: 1px solid #f0f0f0;
        border-radius: var(--radius);
        padding: 1.25rem 1.5rem;
        margin-bottom: 2.5rem;
    }
    .legal-nav p {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--gris);
        margin-bottom: 0.75rem;
    }
    .legal-nav a {
        display: inline-block;
        font-size: 0.85rem;
        color: var(--rose);
        margin-right: 1.5rem;
        text-decoration: none;
    }
    .legal-nav a:hover { text-decoration: underline; }
</style>
{% endblock %}

{% block content %}
    <section class="legal-hero">
        <div class="container">
            <h1>{% block legal_title %}{% endblock %}</h1>
            <div class="mb-2"><span style="display:inline-block;width:40px;height:2px;background:var(--rose);"></span></div>
            <p>Nice K'Cream Beauty — {% block legal_subtitle %}{% endblock %}</p>
        </div>
    </section>

    <div class="container">
        <div class="legal-body">
            <div class="legal-nav">
                <p>Documents légaux</p>
                <a href="{{ path('app_front_mentions_legales') }}">Mentions légales</a>
                <a href="{{ path('app_front_cgv') }}">CGV</a>
                <a href="{{ path('app_front_confidentialite') }}">Confidentialité</a>
                <a href="{{ path('app_front_cookies') }}">Cookies</a>
            </div>
            <span class="legal-update">Dernière mise à jour : juin 2026</span>
            {% block legal_content %}{% endblock %}
        </div>
    </div>
{% endblock %}