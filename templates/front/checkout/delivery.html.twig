{% extends 'front/base.html.twig' %}

{% block title %}Mode de livraison — Nice K'Cream Beauty{% endblock %}

{% block content %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-7">
                <h1 class="mb-4">Mode de livraison</h1>

                <div class="d-flex justify-content-between mb-4 text-muted small">
                    <a href="{{ path('app_front_checkout_address') }}" class="text-decoration-none text-muted">1. Adresse</a>
                    <span class="fw-bold" style="color: #c95f83;">2. Livraison</span>
                    <span>3. Récapitulatif</span>
                    <span>4. Paiement</span>
                </div>

                <form method="post">
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="delivery_method" value="colissimo" id="colissimo"
                                    {{ selectedMethod == 'colissimo' or selectedMethod is null ? 'checked' : '' }} required>
                                <label class="form-check-label" for="colissimo">
                                    <strong>Livraison Colissimo</strong><br>
                                    <span class="text-muted">
                                        {% if colissimoCost > 0 %}
                                            {{ colissimoCost|number_format(2, ',', ' ') }} €
                                        {% else %}
                                            Gratuite (panier ≥ 70 €)
                                        {% endif %}
                                        — 2 à 3 jours ouvrés
                                    </span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="delivery_method" value="retrait_boutique" id="retrait_boutique"
                                    {{ selectedMethod == 'retrait_boutique' ? 'checked' : '' }} required>
                                <label class="form-check-label" for="retrait_boutique">
                                    <strong>Retrait en boutique</strong><br>
                                    <span class="text-muted">Gratuit — préparation sous 24/48h, vous serez notifié(e)</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-pink btn-lg w-100 mt-3">Continuer</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}