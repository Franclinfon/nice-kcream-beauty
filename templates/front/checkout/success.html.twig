{% extends 'front/base.html.twig' %}

{% block title %}Commande confirmée — Nice K'Cream Beauty{% endblock %}

{% block content %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-7 text-center">

                <div class="mb-4" style="font-size: 4rem;">🎉</div>
                <h1 class="mb-3">Merci pour votre commande !</h1>
                <p class="lead text-muted mb-4">
                    Votre commande <strong>{{ order.numeroCommande }}</strong> a bien été reçue.<br>
                    {% if order.statut == 'payee' %}
                        Le paiement a été confirmé.
                    {% else %}
                        Votre paiement est en cours de confirmation.
                    {% endif %}
                </p>

                <div class="card border-0 shadow-sm mb-4 text-start">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Récapitulatif</h6>
                        <table class="table table-sm">
                            <tbody>
                                {% for item in order.orderItems %}
                                    <tr>
                                        <td>{{ item.nomProduit }} × {{ item.quantite }}</td>
                                        <td class="text-end">{{ (item.prixUnitaire * item.quantite)|number_format(2, ',', ' ') }} €</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        <hr>
                        <div class="d-flex justify-content-between text-muted">
                            <span>Livraison</span>
                            <span>{{ order.shippingCost > 0 ? order.shippingCost|number_format(2, ',', ' ') ~ ' €' : 'Gratuite' }}</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold mt-2">
                            <span>Total payé</span>
                            <span style="color: #c95f83;">{{ order.montantTotal|number_format(2, ',', ' ') }} €</span>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4 text-start">
                    <div class="card-body">
                        <h6 class="fw-bold mb-2">Adresse de livraison</h6>
                        <p class="text-muted mb-0">
                            {{ order.livraisonNom }}<br>
                            {{ order.livraisonRue }}{% if order.livraisonComplement %}, {{ order.livraisonComplement }}{% endif %}<br>
                            {{ order.livraisonCodePostal }} {{ order.livraisonVille }}, {{ order.livraisonPays }}
                        </p>
                    </div>
                </div>

                <a href="{{ path('app_front_home') }}" class="btn btn-pink btn-lg">Retour à l'accueil</a>
                <a href="{{ path('app_front_product_index') }}" class="btn btn-outline-dark btn-lg ms-2">Continuer mes achats</a>
            </div>
        </div>
    </div>
{% endblock %}