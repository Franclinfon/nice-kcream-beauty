{% extends 'front/base.html.twig' %}

{% block title %}Récapitulatif de commande — Nice K'Cream Beauty{% endblock %}

{% block content %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <h1 class="mb-4">Récapitulatif de votre commande</h1>

                <div class="d-flex justify-content-between mb-4 text-muted small">
                    <a href="{{ path('app_front_checkout_address') }}" class="text-decoration-none text-muted">1. Adresse</a>
                    <a href="{{ path('app_front_checkout_delivery') }}" class="text-decoration-none text-muted">2. Livraison</a>
                    <span class="fw-bold" style="color: #c95f83;">3. Récapitulatif</span>
                    <span>4. Paiement</span>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="fw-bold">Adresse de livraison</h6>
                            <p class="mb-0 text-muted">
                                {{ address.label }}<br>
                                {{ address.rue }}{% if address.complement %}, {{ address.complement }}{% endif %}<br>
                                {{ address.codePostal }} {{ address.ville }}, {{ address.pays }}
                            </p>
                        </div>
                        <a href="{{ path('app_front_checkout_address') }}" class="text-decoration-none small" style="color: #c95f83;">Modifier</a>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1">Mode de livraison</h6>
                            <p class="mb-0 text-muted">
                                {{ deliveryMethod == 'colissimo' ? 'Livraison Colissimo — 2 à 3 jours ouvrés' : 'Retrait en boutique — sous 24/48h' }}
                            </p>
                        </div>
                        <a href="{{ path('app_front_checkout_delivery') }}" class="text-decoration-none small" style="color: #c95f83;">Modifier</a>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Articles</h6>
                        <table class="table table-sm">
                            <tbody>
                                {% for item in cartItems %}
                                <tr>
                                    <td>
                                        {% if item.type == 'coffret' %}
                                            {{ item.coffret.nom }} × {{ item.quantity }}
                                        {% else %}
                                            {{ item.product.nom }} × {{ item.quantity }}
                                        {% endif %}
                                    </td>
                                    <td class="text-end">{{ item.subtotal|number_format(2, ',', ' ') }} €</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        <hr>
                        <div class="d-flex justify-content-between text-muted">
                            <span>Sous-total</span>
                            <span>{{ total|number_format(2, ',', ' ') }} €</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted">
                            <span>Livraison</span>
                            <span>{{ shippingCost > 0 ? shippingCost|number_format(2, ',', ' ') ~ ' €' : 'Gratuite' }}</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Total</span>
                            <span style="color: #c95f83;">{{ totalWithShipping|number_format(2, ',', ' ') }} €</span>
                        </div>
                    </div>
                </div>

                <form method="post">
                    <button type="submit" class="btn btn-pink btn-lg w-100">Confirmer et payer</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}