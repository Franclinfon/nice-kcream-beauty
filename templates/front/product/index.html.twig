{% extends 'front/base.html.twig' %}

{% block title %}Boutique — Nice K'Cream Beauty{% endblock %}

{% block content %}
<div class="container py-5">
    <h1 class="mb-4">Boutique</h1>

    <div class="row">
        {# Sidebar #}
        <div class="col-md-3 mb-4">

            {# Recherche #}
            <form method="get" action="{{ path('app_front_product_index') }}" class="mb-4">
                <div class="input-group">
                    <input type="text" name="q" value="{{ currentSearch ?? '' }}" class="form-control" placeholder="Rechercher...">
                    <button type="submit" class="btn btn-outline-secondary">🔍</button>
                </div>
                {% if currentCategorySlug %}
                    <input type="hidden" name="categorie" value="{{ currentCategorySlug }}">
                {% endif %}
            </form>

            {# Catégories #}
            <h6 class="fw-bold mb-3">Catégories</h6>
            <ul class="list-unstyled mb-4">
                <li class="mb-2">
                    <a href="{{ path('app_front_product_index') }}" class="text-decoration-none {{ currentCategorySlug is null and not nouveautesOnly and not promosOnly ? 'fw-bold' : 'text-muted' }}">
                        Tous les produits
                    </a>
                </li>
                {% for category in categories %}
                    <li class="mb-2">
                        <a href="{{ path('app_front_product_index', {categorie: category.slug}) }}" class="text-decoration-none {{ currentCategorySlug == category.slug ? 'fw-bold' : 'text-muted' }}">
                            {{ category.nom }}
                        </a>
                    </li>
                {% endfor %}
            </ul>

            {# Filtres rapides #}
            <h6 class="fw-bold mb-3">Filtres</h6>
            <ul class="list-unstyled mb-4">
                <li class="mb-2">
                    <a href="{{ path('app_front_product_index', {nouveautes: 1}) }}" class="text-decoration-none {{ nouveautesOnly ? 'fw-bold' : 'text-muted' }}">
                        🆕 Nouveautés
                    </a>
                </li>
                <li class="mb-2">
                    <a href="{{ path('app_front_product_index', {promos: 1}) }}" class="text-decoration-none {{ promosOnly ? 'fw-bold' : 'text-muted' }}">
                        🏷️ Promotions
                    </a>
                </li>
            </ul>
        </div>

        {# Grille produits #}
        <div class="col-md-9">

            {# Barre de tri + résultats #}
            <div class="d-flex justify-content-between align-items-center mb-4">
                <span class="text-muted small">{{ products|length }} produit{{ products|length > 1 ? 's' : '' }} trouvé{{ products|length > 1 ? 's' : '' }}</span>
                <form method="get" action="{{ path('app_front_product_index') }}" class="d-flex align-items-center gap-2">
                    {% if currentCategorySlug %}<input type="hidden" name="categorie" value="{{ currentCategorySlug }}">{% endif %}
                    {% if currentSearch %}<input type="hidden" name="q" value="{{ currentSearch }}">{% endif %}
                    <label class="text-muted small mb-0">Trier par :</label>
                    <select name="tri" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                        <option value="nouveautes" {{ currentSort == 'nouveautes' ? 'selected' : '' }}>Nouveautés</option>
                        <option value="prix_asc" {{ currentSort == 'prix_asc' ? 'selected' : '' }}>Prix croissant</option>
                        <option value="prix_desc" {{ currentSort == 'prix_desc' ? 'selected' : '' }}>Prix décroissant</option>
                    </select>
                </form>
            </div>

            {# Recherche active #}
            {% if currentSearch %}
                <div class="alert alert-light mb-4">
                    Résultats pour "<strong>{{ currentSearch }}</strong>"
                    <a href="{{ path('app_front_product_index') }}" class="ms-2 text-muted small">✕ Effacer</a>
                </div>
            {% endif %}

            <div class="row">
                {% for product in products %}
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 border-0 shadow-sm position-relative">

                            {# Badges #}
                            <div class="position-absolute top-0 start-0 p-2 d-flex flex-column gap-1" style="z-index: 1;">
                                {% if product.isNouveaute %}
                                    <span class="badge" style="background-color: #2d2d2d;">NOUVEAU</span>
                                {% endif %}
                                {% if product.prixPromo %}
                                    {% set discount = ((product.prix - product.prixPromo) / product.prix * 100)|round %}
                                    <span class="badge bg-danger">-{{ discount }}%</span>
                                {% endif %}
                            </div>

                            <a href="{{ path('app_front_product_show', {slug: product.slug}) }}" class="text-decoration-none text-dark">
                                {% if product.mainImage %}
                                    <img src="{{ asset('uploads/products/' ~ product.mainImage.filename) }}" class="card-img-top" alt="{{ product.nom }}" style="height: 220px; object-fit: cover;">
                                {% else %}
                                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
                                        <span class="text-muted">Pas d'image</span>
                                    </div>
                                {% endif %}

                                <div class="card-body text-center">
                                    <h6 class="card-title mb-1">{{ product.nom }}</h6>
                                    <p class="text-muted small mb-2">{{ product.category.nom }}</p>
                                    {% if product.prixPromo %}
                                        <p class="mb-0">
                                            <span class="text-decoration-line-through text-muted small">{{ product.prix|number_format(2, ',', ' ') }} €</span>
                                            <span class="fw-bold ms-1" style="color: #c95f83;">{{ product.prixPromo|number_format(2, ',', ' ') }} €</span>
                                        </p>
                                    {% else %}
                                        <p class="fw-bold mb-0" style="color: #c95f83;">{{ product.prix|number_format(2, ',', ' ') }} €</p>
                                    {% endif %}
                                </div>
                            </a>

                            {# Bouton ajout panier #}
                            <div class="card-footer bg-white border-0 text-center pb-3">
                                {% if not product.isRupture %}
                                    <form action="{{ path('app_front_cart_add', {id: product.id}) }}" method="post">
                                        <input type="hidden" name="quantity" value="1">
                                        <button type="submit" class="btn btn-pink btn-sm w-100">Ajouter au panier</button>
                                    </form>
                                {% else %}
                                    <button class="btn btn-secondary btn-sm w-100" disabled>Rupture de stock</button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <p class="text-muted text-center py-5">Aucun produit trouvé.</p>
                        <div class="text-center">
                            <a href="{{ path('app_front_product_index') }}" class="btn btn-pink">Voir tous les produits</a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}