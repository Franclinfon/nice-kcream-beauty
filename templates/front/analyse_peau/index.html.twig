{% extends 'front/base.html.twig' %}

{% block title %}Analyse de peau personnalisée — Nice K'Cream Beauty{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* ===== HERO ANALYSE ===== */
    .analyse-hero {
        background: linear-gradient(135deg, var(--rose-pale) 0%, #fdf6f0 100%);
        padding: 5rem 0 4rem;
        position: relative;
        overflow: hidden;
    }
    .analyse-hero::before {
        content: '';
        position: absolute;
        top: -50px;
        right: -50px;
        width: 400px;
        height: 400px;
        border-radius: 50%;
        background: rgba(201, 95, 131, 0.06);
    }
    .analyse-hero::after {
        content: '';
        position: absolute;
        bottom: -80px;
        left: -80px;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        background: rgba(201, 95, 131, 0.04);
    }
    .analyse-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: white;
        border: 1.5px solid var(--rose);
        border-radius: 50px;
        padding: 0.4rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--rose);
        margin-bottom: 1.5rem;
    }
    .analyse-hero h1 {
        font-family: var(--font-titre);
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        color: var(--noir);
        line-height: 1.2;
        margin-bottom: 1.5rem;
    }
    .analyse-hero h1 span {
        color: var(--rose);
        font-style: italic;
    }
    .analyse-hero-text {
        font-size: 1rem;
        color: #4b5563;
        line-height: 1.8;
        max-width: 500px;
        margin-bottom: 2rem;
    }
    .btn-analyse {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: var(--rose) !important;
        color: white !important;
        border: none;
        padding: 1rem 2rem;
        border-radius: 6px;
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 4px 20px rgba(201, 95, 131, 0.3);
    }
    .btn-analyse:hover {
        background: #b54d71 !important;
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(201, 95, 131, 0.4);
        color: white !important;
    }
    .analyse-hero-img {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.1);
        position: relative;
        z-index: 1;
    }
    .analyse-hero-img img {
        width: 100%;
        height: 420px;
        object-fit: cover;
    }
    .analyse-hero-img-placeholder {
        width: 100%;
        height: 420px;
        background: linear-gradient(135deg, var(--rose-pale), #fdf6f0);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ===== SECTION POURQUOI ===== */
    .analyse-pourquoi {
        padding: 5rem 0;
        background: white;
    }
    .analyse-section-title {
        font-family: var(--font-titre);
        font-size: 1.8rem;
        font-weight: 600;
        color: var(--noir);
        margin-bottom: 0.5rem;
    }
    .analyse-feature {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
        margin-bottom: 2rem;
    }
    .analyse-feature-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: var(--rose-pale);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .analyse-feature-title {
        font-family: var(--font-corps);
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--noir);
        margin-bottom: 0.3rem;
    }
    .analyse-feature-desc {
        font-size: 0.85rem;
        color: var(--gris);
        line-height: 1.6;
        margin: 0;
    }

    /* ===== SECTION ETAPES ===== */
    .analyse-etapes {
        padding: 5rem 0;
        background: var(--rose-pale);
    }
    .etape-card {
        background: white;
        border-radius: 12px;
        padding: 2rem 1.5rem;
        text-align: center;
        height: 100%;
        position: relative;
    }
    .etape-number {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--rose);
        color: white;
        font-weight: 700;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
    }
    .etape-title {
        font-family: var(--font-titre);
        font-size: 1rem;
        font-weight: 600;
        color: var(--noir);
        margin-bottom: 0.75rem;
    }
    .etape-desc {
        font-size: 0.85rem;
        color: var(--gris);
        line-height: 1.6;
        margin: 0;
    }

    /* ===== CTA FINAL ===== */
    .analyse-cta {
        padding: 5rem 0;
        background: var(--noir);
        text-align: center;
    }
    .analyse-cta h2 {
        font-family: var(--font-titre);
        font-size: 2rem;
        color: white;
        margin-bottom: 1rem;
    }
    .analyse-cta h2 span {
        color: var(--rose);
        font-style: italic;
    }
    .analyse-cta p {
        color: rgba(255,255,255,0.7);
        font-size: 0.95rem;
        margin-bottom: 2rem;
    }
    .btn-cta-white {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: white !important;
        color: var(--noir) !important;
        border: none;
        padding: 1rem 2.5rem;
        border-radius: 6px;
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-decoration: none;
        transition: all 0.3s ease;
    }
    .btn-cta-white:hover {
        background: var(--rose-pale) !important;
        transform: translateY(-2px);
    }
</style>
{% endblock %}

{% block content %}

    {# Hero #}
    <section class="analyse-hero">
        <div class="container position-relative" style="z-index:1;">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="analyse-hero-badge">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="5"/><path d="M9 13.5C9 16 10.3 18 12 18s3-2 3-4.5"/></svg>
                        Offerte en boutique
                    </div>
                    <h1>
                        Analyse de peau<br>
                        <span>personnalisée</span>
                    </h1>
                    <p class="analyse-hero-text">
                        Découvrez les besoins réels de votre peau grâce à une analyse réalisée par une professionnelle formée à l'esthétique et à la K-Beauty. Chaque recommandation est adaptée à votre type de peau et à vos objectifs.
                    </p>
                    <a href="https://www.fresha.com/fr/a/nice-kcream-beauty-angers-4-place-pierre-mendes-france-mh3yfeql"
                       target="_blank" rel="noopener"
                       class="btn-analyse">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        Réserver une analyse de peau
                    </a>
                </div>
                <div class="col-lg-6">
                    <div class="analyse-hero-img">
                        <img src="{{ asset('images/analys_peau.png') }}" alt="Analyse de peau personnalisée Nice K'Cream Beauty">
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# Pourquoi faire une analyse ? #}
    <section class="analyse-pourquoi">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <h2 class="analyse-section-title">Pourquoi faire une analyse de peau ?</h2>
                    <div class="mb-4"><span style="display:inline-block;width:40px;height:2px;background:var(--rose);"></span></div>

                    <div class="analyse-feature">
                        <div class="analyse-feature-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                        </div>
                        <div>
                            <p class="analyse-feature-title">Comprendre votre peau</p>
                            <p class="analyse-feature-desc">Identifier votre type de peau (grasse, sèche, mixte, sensible) et ses problématiques spécifiques grâce à un diagnostic professionnel.</p>
                        </div>
                    </div>

                    <div class="analyse-feature">
                        <div class="analyse-feature-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        </div>
                        <div>
                            <p class="analyse-feature-title">Des recommandations sur mesure</p>
                            <p class="analyse-feature-desc">Recevoir des conseils personnalisés sur les soins et produits K-Beauty adaptés à vos besoins réels, sans vous perdre dans des dizaines de références.</p>
                        </div>
                    </div>

                    <div class="analyse-feature">
                        <div class="analyse-feature-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                        </div>
                        <div>
                            <p class="analyse-feature-title">Prendre soin de vous</p>
                            <p class="analyse-feature-desc">Un moment privilégié avec une experte passionnée, dans un cadre cosy et bienveillant, pour prendre enfin soin de votre peau comme elle le mérite.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div style="background: var(--rose-pale); border-radius: 16px; padding: 2.5rem;">
                        <h3 style="font-family: var(--font-titre); font-size: 1.3rem; color: var(--noir); margin-bottom: 1.5rem;">Ce que comprend l'analyse</h3>
                        {% set points = [
                            'Diagnostic visuel complet de votre peau',
                            'Analyse de vos habitudes de soin actuelles',
                            'Identification de vos objectifs beauté',
                            'Recommandations de produits K-Beauty adaptés',
                            'Conseils pour construire votre routine personnalisée',
                            'Questions / réponses avec notre experte'
                        ] %}
                        {% for point in points %}
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="2.5" style="flex-shrink:0; margin-top:2px;"><polyline points="20 6 9 17 4 12"/></svg>
                            <p style="font-size:0.9rem; color:var(--noir); margin:0; line-height:1.5;">{{ point }}</p>
                        </div>
                        {% endfor %}
                        <div style="margin-top:1.5rem; padding-top:1.5rem; border-top:1px solid rgba(201,95,131,0.2);">
                            <p style="font-size:0.85rem; color:var(--rose); font-weight:700; margin:0;">
                                ✦ Entièrement gratuite en boutique
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# Les étapes #}
    <section class="analyse-etapes">
        <div class="container">
            <h2 class="analyse-section-title text-center mb-2">Comment ça se passe ?</h2>
            <div class="text-center mb-5"><span style="display:inline-block;width:40px;height:2px;background:var(--rose);"></span></div>
            <div class="row g-4">
                <div class="col-md-3">
                    <div class="etape-card">
                        <div class="etape-number">1</div>
                        <h4 class="etape-title">Prise de rendez-vous</h4>
                        <p class="etape-desc">Réservez votre créneau en ligne sur Fresha en quelques clics, sans avance ni carte bancaire.</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="etape-card">
                        <div class="etape-number">2</div>
                        <h4 class="etape-title">Accueil en boutique</h4>
                        <p class="etape-desc">Vous êtes reçue dans notre institut cosy d'Angers par une experte K-Beauty formée et passionnée.</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="etape-card">
                        <div class="etape-number">3</div>
                        <h4 class="etape-title">Diagnostic personnalisé</h4>
                        <p class="etape-desc">Analyse visuelle et échange approfondi sur vos habitudes, votre peau et vos objectifs beauté.</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="etape-card">
                        <div class="etape-number">4</div>
                        <h4 class="etape-title">Recommandations</h4>
                        <p class="etape-desc">Vous repartez avec une routine K-Beauty sur mesure et les conseils pour prendre soin de votre peau au quotidien.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# CTA final #}
    <section class="analyse-cta">
        <div class="container">
            <h2>Prête à révéler l'éclat<br><span>naturel de votre peau ?</span></h2>
            <p>Réservez votre analyse de peau offerte dès maintenant.<br>Disponible du lundi au samedi, 10h30–18h30.</p>
            <a href="https://www.fresha.com/fr/a/nice-kcream-beauty-angers-4-place-pierre-mendes-france-mh3yfeql"
               target="_blank" rel="noopener"
               class="btn-cta-white">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                Réserver mon analyse de peau
            </a>
        </div>
    </section>

{% endblock %}