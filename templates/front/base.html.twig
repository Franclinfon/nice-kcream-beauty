                            </span>
                        {% endif %}
                    </a>
                    <a href="https://share.google/XNtyVAzeKl9r4qIEV" target="_blank" class="btn btn-pink btn-hero d-flex align-items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        Réserver un soin
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main>
        {% block content %}{% endblock %}
    </main>

    <footer class="py-5 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5>Nice K'Cream Beauty</h5>
                    <p class="small" style="color: rgba(255,255,255,0.6); line-height: 1.7;">
                        Institut spécialisé en beauté coréenne, soins experts et cosmétiques sélectionnés pour révéler l'éclat naturel de votre peau.
                    </p>
                </div>
                <div class="col-md-2 mb-4">
                    <h6>Boutique</h6>
                    <ul class="list-unstyled">
                        <li class="mb-1"><a href="{{ path('app_front_product_index') }}">Tous nos produits</a></li>
                        <li class="mb-1"><a href="#">Nouveautés</a></li>
                        <li class="mb-1"><a href="#">Promotions</a></li>
                        <li class="mb-1"><a href="#">Coffrets</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6>Soins</h6>
                    <ul class="list-unstyled">
                        <li class="mb-1"><a href="#">Soins visage</a></li>
                        <li class="mb-1"><a href="#">Épilation laser</a></li>
                        <li class="mb-1"><a href="#">Massages</a></li>
                        <li class="mb-1"><a href="#">Analyse de peau</a></li>
                        <li class="mb-1"><a href="#">Réserver sur Fresha</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6>À propos</h6>
                    <ul class="list-unstyled">
                        <li class="mb-1"><a href="#">Notre histoire</a></li>
                        <li class="mb-1"><a href="#">Expertise</a></li>
                        <li class="mb-1"><a href="#">Formation</a></li>
                        <li class="mb-1"><a href="#">Le salon</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6>Aide & infos</h6>
                    <ul class="list-unstyled">
                        <li class="mb-1"><a href="#">Livraison</a></li>
                        <li class="mb-1"><a href="#">Retours & échanges</a></li>
