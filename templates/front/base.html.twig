{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* ===== VARIABLES ===== */
    :root {
        --rose: #c95f83;
        --rose-light: #e0769a;
        --rose-pale: #fdf0f4;
        --creme: #fdf6f0;
        --noir: #1a1a1a;
        --gris: #6b7280;
        --gris-clair: #f9fafb;
        --or: #c9a96e;
        --blanc: #ffffff;
        --font-titre: 'Playfair Display', Georgia, serif;
        --font-corps: 'Inter', sans-serif;
        --radius: 12px;
        --shadow: 0 2px 20px rgba(0,0,0,0.06);
        --shadow-hover: 0 8px 40px rgba(0,0,0,0.12);
        --transition: 0.3s ease;
    }

    /* ===== RESET & BASE ===== */
    * { box-sizing: border-box; }
    body {
        font-family: var(--font-corps);
        color: var(--noir);
        background: var(--blanc);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4, h5 {
        font-family: var(--font-titre);
        font-weight: 600;
        line-height: 1.2;
    }

    /* ===== TOP BAR ===== */
    .top-bar {
        background-color: var(--rose-pale);
        font-size: 0.8rem;
        padding: 0.5rem 0;
        color: var(--gris);
        letter-spacing: 0.3px;
    }

    /* ===== NAVBAR ===== */
    .navbar-brand-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }
    .navbar-brand-logo .logo-box {
        width: 42px;
        height: 42px;
        border: 1.5px solid var(--noir);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }
    .navbar-brand-logo .logo-box .logo-nk {
        font-family: var(--font-titre);
        font-size: 1rem;
        font-weight: 700;
        color: var(--noir);
        letter-spacing: 1px;
    }
    .navbar-brand-logo .logo-text {
        display: flex;
        flex-direction: column;
    }
    .navbar-brand-logo .logo-text .brand-name {
        font-family: var(--font-titre);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--noir);
        letter-spacing: 2px;
        line-height: 1.1;
    }
    .navbar-brand-logo .logo-text .brand-sub {
        font-family: var(--font-corps);
        font-size: 0.6rem;
        color: var(--gris);
        letter-spacing: 4px;
        text-transform: uppercase;
    }

    .nav-link {
        font-family: var(--font-corps);
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--noir) !important;
        letter-spacing: 0.5px;
        padding: 0.5rem 0.8rem !important;
        transition: color var(--transition);
    }
    .nav-link:hover { color: var(--rose) !important; }

    /* ===== BOUTONS ===== */
    .btn-pink {
        background-color: var(--rose) !important;
        border-color: var(--rose) !important;
        color: var(--blanc) !important;
        font-family: var(--font-corps);
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 0.5px;
        border-radius: 4px;
        transition: all var(--transition);
    }
    .btn-pink:hover {
        background-color: #b54d71 !important;
        border-color: #b54d71 !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(201, 95, 131, 0.3);
    }

    .btn-outline-rose {
        background: transparent !important;
        border: 1.5px solid var(--rose) !important;
        color: var(--rose) !important;
        font-family: var(--font-corps);
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 0.5px;
        border-radius: 4px;
        transition: all var(--transition);
    }
    .btn-outline-rose:hover {
        background: var(--rose) !important;
        color: var(--blanc) !important;
        transform: translateY(-1px);
    }

    /* ===== TRAIT DÉCORATIF ===== */
    .section-divider {
        display: inline-block;
        width: 40px;
        height: 2px;
        background: var(--rose);
        margin: 0.5rem auto 2rem;
    }

    /* ===== CARDS ===== */
    .card-produit {
        border: none;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        transition: all var(--transition);
        overflow: hidden;
    }
    .card-produit:hover {
        box-shadow: var(--shadow-hover);
        transform: translateY(-4px);
    }

    /* ===== FOOTER ===== */
    footer {
        background-color: var(--noir);
        color: rgba(255,255,255,0.8);
    }
    footer a {
        color: rgba(255,255,255,0.65);
        text-decoration: none;
        transition: color var(--transition);
        font-size: 0.85rem;
    }
    footer a:hover { color: var(--blanc); }
    footer h5, footer h6 {
        font-family: var(--font-titre);
        color: var(--blanc);
        font-size: 0.95rem;
        margin-bottom: 1rem;
    }

    /* ===== UTILITAIRES ===== */
    .text-rose { color: var(--rose) !important; }
    .bg-creme { background-color: var(--creme) !important; }
    .bg-rose-pale { background-color: var(--rose-pale) !important; }

    /* ===== HERO ===== */
    .hero-section {
        position: relative;
        min-height: 560px;
    }
    .hero-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center right;
        background-repeat: no-repeat;
    }
    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to right,
            rgba(253, 246, 240, 0.92) 0%,
            rgba(253, 246, 240, 0.75) 45%,
            rgba(253, 246, 240, 0.1) 100%
        );
    }
    .hero-title {
        font-family: var(--font-titre);
        line-height: 1.0;
        margin-bottom: 1.5rem;
    }
    .hero-title-rose {
        font-size: 3.2rem;
        font-weight: 600;
        font-style: italic;
        color: var(--rose);
        white-space: nowrap;
    }
    .hero-title-noir {
        font-size: 3.2rem;
        font-weight: 700;
        font-style: normal;
        color: var(--noir);
        white-space: nowrap;
    }
    .hero-subtitle {
        font-family: var(--font-corps);
        font-size: 1rem;
        color: #4a4a4a;
        line-height: 1.8;
        font-weight: 400;
    }
    .btn-hero {
        padding: 0.75rem 1.75rem;
        font-size: 0.9rem;
        border-radius: 4px;
    }
    .hero-badge {
        position: absolute;
        bottom: 40px;
        right: 60px;
        z-index: 3;
        width: 110px;
        height: 110px;
        border-radius: 50%;
        background: rgba(255,255,255,0.9);
        border: 1.5px solid var(--rose);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        box-shadow: 0 4px 20px rgba(201,95,131,0.15);
    }
    .hero-badge-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1px;
    }
    .hero-badge-icon {
        color: var(--rose);
        font-size: 1rem;
        margin-bottom: 2px;
    }
    .hero-badge-line1 {
        font-family: var(--font-corps);
        font-size: 0.55rem;
        font-weight: 600;
        letter-spacing: 1px;
        color: var(--noir);
        text-transform: uppercase;
    }
    .hero-badge-line2 {
        font-family: var(--font-titre);
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--rose);
        font-style: italic;
    }
    .hero-badge-line3 {
        font-family: var(--font-corps);
        font-size: 0.55rem;
        font-weight: 600;
        letter-spacing: 1px;
        color: var(--noir);
        text-transform: uppercase;
    }

    /* ===== BANDEAU COOKIES ===== */
    #cookie-banner {
        position: fixed;
        bottom: 50px;
        left: 0;
        right: 0;
        z-index: 9999;
        background: #1a1a1a;
        color: rgba(255,255,255,0.85);
        padding: 1rem 1.5rem;
        font-size: 0.85rem;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.2);
    }
</style>
{% endblock %}

