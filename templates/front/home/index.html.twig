{% extends 'front/base.html.twig' %}

{% block title %}Nice K'Cream Beauty — La référence K-Beauty à Angers{% endblock %}

{% block content %}

    {# Hero #}
    <section class="hero-section position-relative overflow-hidden">

        {# Image de fond #}
        <div class="hero-bg" style="background-image: url('{{ asset('images/hero-banner.png') }}');"></div>

        {# Overlay dégradé pour lisibilité du texte #}
        <div class="hero-overlay"></div>

        <div class="container position-relative" style="z-index: 2;">
            <div class="row align-items-center" style="min-height: 560px;">
                <div class="col-lg-5 py-5">

                    {# Titre deux lignes #}
                    <h1 class="hero-title mb-3">
                        <span class="hero-title-rose">L'Essence</span><br>
                        <span class="hero-title-noir">d'une Peau Éclatante</span>
                    </h1>

                    <p class="hero-subtitle mb-5">
                        Soins experts, produits coréens sélectionnés<br>
                        pour leur efficacité, leur innovation<br>
                        et le respect de votre peau.
                    </p>

                    <div class="d-flex gap-3 flex-wrap">
                        <a href="{{ path('app_front_product_index') }}" class="btn btn-pink btn-hero d-flex align-items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                                <line x1="3" y1="6" x2="21" y2="6"/>
                                <path d="M16 10a4 4 0 0 1-8 0"/>
                            </svg>
                            Découvrir la boutique
                        </a>
                        <a href="https://share.google/XNtyVAzeKl9r4qIEV" target="_blank" rel="noopener noreferrer" class="btn btn-outline-rose btn-hero d-flex align-items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                            Réserver un soin
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Badge circulaire #}
        <div class="hero-badge">
            <div class="hero-badge-inner">
                <span class="hero-badge-icon">✦</span>
                <span class="hero-badge-line1">ANALYSE DE PEAU</span>
                <span class="hero-badge-line2">OFFERTE</span>
                <span class="hero-badge-line3">EN BOUTIQUE</span>
            </div>
        </div>

    </section>

    {# Mini-bandeau sous le hero #}
    <section class="hero-sub-banner py-3 bg-white border-bottom">
        <div class="container">
            <div class="row text-center g-3">
                <div class="col-6 col-md-3 d-flex align-items-center justify-content-center gap-2">
                    <span style="color: var(--rose);">✓</span>
                    <span class="small">Produits 100% authentiques</span>
                </div>
                <div class="col-6 col-md-3 d-flex align-items-center justify-content-center gap-2">
                    <span style="color: var(--rose);">✓</span>
                    <span class="small">Livraison rapide Colissimo</span>
                </div>
                <div class="col-6 col-md-3 d-flex align-items-center justify-content-center gap-2">
                    <span style="color: var(--rose);">✓</span>
                    <span class="small">Paiement sécurisé</span>
                </div>
                <div class="col-6 col-md-3 d-flex align-items-center justify-content-center gap-2">
                    <span style="color: var(--rose);">✓</span>
                    <span class="small">Retrait en boutique gratuit</span>
                </div>
            </div>
        </div>
    </section>

    {# Bandeau avantages #}
    <section class="py-4" style="background-color: var(--rose-pale);">
        <div class="container">
            <div class="row">

                {# Soins experts #}
                <div class="col-6 col-md-3 mb-3 mb-md-0">
                    <div class="d-flex align-items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;">
                            <path d="M12 2a9 9 0 0 1 0 18A9 9 0 0 1 12 2z"/>
                            <path d="M12 2c0 0-4 4-4 9s4 9 4 9"/>
                            <path d="M12 2c0 0 4 4 4 9s-4 9-4 9"/>
                            <path d="M3.6 9h16.8"/>
                            <path d="M3.6 15h16.8"/>
                        </svg>
                        <div>
                            <p class="mb-1" style="font-family: var(--font-corps); font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--noir);">SOINS EXPERTS</p>
                            <p class="mb-0" style="font-family: var(--font-corps); font-size: 0.8rem; color: var(--gris); line-height: 1.5;">Des protocoles ciblés pour répondre à chaque besoin de votre peau.</p>
                        </div>
                    </div>
                </div>

                {# Expertise K-Beauty #}
                <div class="col-6 col-md-3 mb-3 mb-md-0">
                    <div class="d-flex align-items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;">
                            <path d="M9 3H5a2 2 0 0 0-2 2v4"/>
                            <path d="M9 3h6"/>
                            <path d="M15 3h4a2 2 0 0 1 2 2v4"/>
                            <path d="M3 9v6"/>
                            <path d="M21 9v6"/>
                            <path d="M3 15v2a2 2 0 0 0 2 2h4"/>
                            <path d="M15 19h4a2 2 0 0 0 2-2v-2"/>
                            <path d="M9 19h6"/>
                            <circle cx="12" cy="11" r="2"/>
                            <path d="M12 13v5"/>
                        </svg>
                        <div>
                            <p class="mb-1" style="font-family: var(--font-corps); font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--noir);">EXPERTISE K-BEAUTY</p>
                            <p class="mb-0" style="font-family: var(--font-corps); font-size: 0.8rem; color: var(--gris); line-height: 1.5;">Des produits coréens rigoureusement sélectionnés pour des résultats visibles.</p>
                        </div>
                    </div>
                </div>

                {# Analyse de peau #}
                <div class="col-6 col-md-3 mb-3 mb-md-0">
                    <div class="d-flex align-items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;">
                            <circle cx="12" cy="8" r="5"/>
                            <path d="M8 8a4 4 0 0 1 8 0"/>
                            <path d="M9 13.5C9 16 10.3 18 12 18s3-2 3-4.5"/>
                            <path d="M12 18v3"/>
                            <path d="M9 21h6"/>
                        </svg>
                        <div>
                            <p class="mb-1" style="font-family: var(--font-corps); font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--noir);">ANALYSE DE PEAU OFFERTE</p>
                            <p class="mb-0" style="font-family: var(--font-corps); font-size: 0.8rem; color: var(--gris); line-height: 1.5;">Un diagnostic personnalisé grâce à notre technologie de pointe.</p>
                        </div>
                    </div>
                </div>

                {# Référence à Angers #}
                <div class="col-6 col-md-3">
                    <div class="d-flex align-items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;">
                            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                            <circle cx="12" cy="9" r="2.5"/>
                        </svg>
                        <div>
                            <p class="mb-1" style="font-family: var(--font-corps); font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--noir);">RÉFÉRENCE À ANGERS</p>
                            <p class="mb-0" style="font-family: var(--font-corps); font-size: 0.8rem; color: var(--gris); line-height: 1.5;">Votre institut spécialisé en beauté coréenne au cœur d'Angers.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    {# Nos soins experts #}
    <section class="py-5 bg-light">
        <div class="container">
            <h2 class="text-center mb-2">Nos soins experts</h2>
            <div class="text-center mb-5"><span style="display:inline-block;width:40px;height:2px;background:#c95f83;"></span></div>
            <div class="row">
                {% for service in services %}
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 border-0 shadow-sm">
                            {% if service.image %}
                                <img src="{{ asset('uploads/services/' ~ service.image) }}" class="card-img-top" style="height: 200px; object-fit: cover;" alt="{{ service.titre }}">
                            {% endif %}
                            <div class="card-body">
                                <h5 class="card-title">{{ service.titre }}</h5>
                                <p class="card-text text-muted small">{{ service.description }}</p>
                                <a href="#" class="text-decoration-none fw-bold" style="color: #c95f83;">Découvrir</a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-center text-muted">Aucun soin publié pour le moment.</p>
                {% endfor %}
            </div>
            <div class="text-center mt-3">
                <a href="#" class="btn btn-pink">Voir tous nos soins</a>
            </div>
        </div>
    </section>

    {# Produits phares #}
    <section class="py-5">
        <div class="container">
            <h2 class="mb-2">Produits phares</h2>
            <div class="mb-4"><span style="display:inline-block;width:40px;height:2px;background:#c95f83;"></span></div>
            <div class="row">
                {% for product in featuredProducts %}
                    <div class="col-md-3 mb-4">
                        <div class="card h-100 border-0 shadow-sm position-relative">
                            {% if product.isNouveaute %}
                                <span class="badge position-absolute top-0 start-0 m-2" style="background-color: #2d2d2d; z-index:1;">NOUVEAU</span>
                            {% endif %}
                            {% if product.prixPromo %}
                                {% set discount = ((product.prix - product.prixPromo) / product.prix * 100)|round %}
                                <span class="badge bg-danger position-absolute top-0 start-0 m-2 mt-5" style="z-index:1;">-{{ discount }}%</span>
                            {% endif %}
                            <a href="{{ path('app_front_product_show', {slug: product.slug}) }}" class="text-decoration-none text-dark">
                                <div class="text-center p-3">
                                    {% if product.mainImage %}
                                        <img src="{{ asset('uploads/products/' ~ product.mainImage.filename) }}" class="img-fluid" style="max-height: 150px; object-fit: contain;" alt="{{ product.nom }}">
                                    {% endif %}
                                </div>
                                <div class="card-body text-center pt-0">
                                    <h6 class="card-title mb-1">{{ product.nom }}</h6>
                                    {% if product.prixPromo %}
                                        <p class="mb-0">
                                            <span class="text-decoration-line-through text-muted small">{{ product.prix|number_format(2, ',', ' ') }} €</span>
                                            <span class="fw-bold" style="color: #c95f83;">{{ product.prixPromo|number_format(2, ',', ' ') }} €</span>
                                        </p>
                                    {% else %}
                                        <p class="fw-bold mb-0" style="color: #c95f83;">{{ product.prix|number_format(2, ',', ' ') }} €</p>
                                    {% endif %}
                                </div>
                            </a>
                        </div>
                    </div>
                {% else %}
                    <p class="text-center text-muted">Aucun produit mis en avant pour le moment.</p>
                {% endfor %}
            </div>
            <div class="text-center mt-3">
                <a href="{{ path('app_front_product_index') }}" class="btn btn-pink">Voir toute la boutique</a>
            </div>
        </div>
    </section>

    {# Avis / Avant-Après / Blog #}
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row">

                {# Avis clients #}
                <div class="col-md-4 mb-4">
                    <h4 class="mb-2">Avis de nos clientes</h4>
                    <div class="mb-4"><span style="display:inline-block;width:40px;height:2px;background:#c95f83;"></span></div>
                    {% if reviews|length > 0 %}
                        {% for review in reviews %}
                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-body">
                                    <div class="mb-1">
                                        {% for i in 1..5 %}{{ i <= review.note ? '⭐' : '☆' }}{% endfor %}
                                    </div>
                                    <p class="text-muted small fst-italic mb-1">"{{ review.commentaire }}"</p>
                                    <p class="small fw-bold mb-0">{{ review.client.prenom }} {{ review.client.nom[0] }}.</p>
                                </div>
                            </div>
                        {% endfor %}
                        <a href="#" class="text-decoration-none fw-bold small" style="color: #c95f83;">Voir tous les avis →</a>
                    {% else %}
                        <p class="text-muted small">Aucun avis pour le moment.</p>
                    {% endif %}
                </div>

                {# Avant / Après #}
                <div class="col-md-4 mb-4">
                    <h4 class="mb-2">Avant / Après</h4>
                    <div class="mb-4"><span style="display:inline-block;width:40px;height:2px;background:#c95f83;"></span></div>
                    {% if beforeAfters|length > 0 %}
                        {% for ba in beforeAfters %}
                            <div class="card border-0 shadow-sm mb-3">
                                <div class="row g-0">
                                    <div class="col-6">
                                        <img src="{{ asset('uploads/before_after/' ~ ba.imageAvant) }}" class="img-fluid rounded-start" style="height: 120px; object-fit: cover; width: 100%;" alt="Avant">
                                        <p class="text-center small text-muted mt-1 mb-0">Avant</p>
                                    </div>
                                    <div class="col-6">
                                        <img src="{{ asset('uploads/before_after/' ~ ba.imageApres) }}" class="img-fluid rounded-end" style="height: 120px; object-fit: cover; width: 100%;" alt="Après">
                                        <p class="text-center small text-muted mt-1 mb-0">Après</p>
                                    </div>
                                </div>
                                {% if ba.titre %}
                                    <div class="card-body py-2">
                                        <p class="small fw-bold mb-0">{{ ba.titre }}</p>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                        <a href="#" class="text-decoration-none fw-bold small" style="color: #c95f83;">Voir la galerie →</a>
                    {% else %}
                        <p class="text-muted small">Aucune photo avant/après pour le moment.</p>
                    {% endif %}
                </div>

                {# Blog #}
                <div class="col-md-4 mb-4">
                    <h4 class="mb-2">Nos derniers conseils</h4>
                    <div class="mb-4"><span style="display:inline-block;width:40px;height:2px;background:#c95f83;"></span></div>
                    {% if blogPosts|length > 0 %}
                        {% for post in blogPosts %}
                            <div class="mb-3">
                                <p class="text-muted small mb-1 text-uppercase">{{ post.categorie }}</p>
                                <h6 class="mb-1">{{ post.titre }}</h6>
                                <a href="#" class="text-decoration-none small" style="color: #c95f83;">Lire l'article →</a>
                            </div>
                            {% if not loop.last %}<hr>{% endif %}
                        {% endfor %}
                        <a href="#" class="text-decoration-none fw-bold small" style="color: #c95f83;">Voir tous les articles →</a>
                    {% else %}
                        <p class="text-muted small">Aucun article pour le moment.</p>
                    {% endif %}
                </div>

            </div>
        </div>
    </section>

    {# Bandeau final #}
    <section class="py-4 border-top">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-3 mb-3 mb-md-0">
                    <span style="font-size: 2rem;">🚚</span>
                    <p class="fw-bold mb-0 mt-2 small">LIVRAISON OFFERTE</p>
                    <p class="text-muted mb-0 small">Dès 70€ d'achat en France métropolitaine</p>
                </div>
                <div class="col-md-3 mb-3 mb-md-0">
                    <span style="font-size: 2rem;">🏪</span>
                    <p class="fw-bold mb-0 mt-2 small">RETRAIT EN BOUTIQUE</p>
                    <p class="text-muted mb-0 small">À Angers sous 24/48h</p>
                </div>
                <div class="col-md-3 mb-3 mb-md-0">
                    <span style="font-size: 2rem;">🔒</span>
                    <p class="fw-bold mb-0 mt-2 small">PAIEMENT SÉCURISÉ</p>
                    <p class="text-muted mb-0 small">Stripe, Apple Pay, Google Pay, CB</p>
                </div>
                <div class="col-md-3">
                    <span style="font-size: 2rem;">💬</span>
                    <p class="fw-bold mb-0 mt-2 small">SERVICE CLIENT</p>
                    <p class="text-muted mb-0 small">À votre écoute du lundi au samedi</p>
                </div>
            </div>
        </div>
    </section>

{% endblock %}