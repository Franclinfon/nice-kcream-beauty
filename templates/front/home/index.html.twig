{% extends 'front/base.html.twig' %}

{% block title %}Nice K'Cream Beauty — La référence K-Beauty à Angers{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ===== SOINS EXPERTS ===== */
.soin-card {
    border: 1px solid #f0f0f0;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
    background: var(--blanc);
}
.soin-card:hover {
    box-shadow: 0 8px 30px rgba(201, 95, 131, 0.12);
    transform: translateY(-3px);
}
.soin-card-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
}
.soin-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}
.soin-card:hover .soin-card-img img {
    transform: scale(1.05);
}
.soin-card-img-placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--rose-pale);
    display: flex;
    align-items: center;
    justify-content: center;
}
.soin-card-body {
    padding: 1rem;
}
.soin-card-title {
    font-family: var(--font-corps);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--noir);
    margin-bottom: 0.5rem;
    line-height: 1.3;
}
.soin-card-desc {
    font-family: var(--font-corps);
    font-size: 0.78rem;
    color: var(--gris);
    line-height: 1.5;
    margin-bottom: 0.75rem;
}
.soin-card-link {
    font-family: var(--font-corps);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--rose);
    text-decoration: none;
    transition: opacity 0.2s;
}
.soin-card-link:hover { opacity: 0.7; }
/* ===== PRODUITS PHARES ===== */
.produit-card {
    background: var(--blanc);
    border: 1px solid #f0f0f0;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
    height: 100%;
}
.produit-card:hover {
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    transform: translateY(-3px);
}
.produit-badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 2;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
}
.produit-badge-new {
    background: #1a1a1a;
    color: white;
}
.produit-badge-promo {
    background: #e53e3e;
    color: white;
    top: 2rem;
}
.produit-card-img-link { display: block; }
.produit-card-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
}
.produit-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}
.produit-card:hover .produit-card-img img {
    transform: scale(1.05);
}
.produit-card-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--rose-pale);
}
.produit-card-body {
    padding: 0.75rem;
}
.produit-card-marque {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--gris);
    margin-bottom: 0.25rem;
}
.produit-card-nom {
    display: block;
    font-family: var(--font-corps);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--noir);
    text-decoration: none;
    line-height: 1.3;
    margin-bottom: 0.5rem;
}
.produit-card-nom:hover { color: var(--rose); }
.produit-card-prix-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.produit-card-prix {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--noir);
}
.produit-card-prix-barre {
    font-size: 0.75rem;
    text-decoration: line-through;
    color: var(--gris);
    margin-right: 0.3rem;
}
.produit-card-prix-promo {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--rose);
}
.produit-card-panier {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--rose-pale);
    color: var(--rose);
    text-decoration: none;
    transition: all 0.2s ease;
    flex-shrink: 0;
}
.produit-card-panier:hover {
    background: var(--rose);
    color: white;
}

/* ===== COFFRETS K-BEAUTY ===== */
.coffret-card {
    background: var(--rose-pale);
    border-radius: 8px;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 200px;
}
.coffret-card-label {
    font-family: var(--font-titre);
    font-size: 1rem;
    font-weight: 600;
    font-style: italic;
    color: var(--rose);
    margin-bottom: 0.5rem;
}
.coffret-card-desc {
    font-size: 0.8rem;
    color: var(--gris);
    line-height: 1.5;
    margin-bottom: 1rem;
}
/* ===== AVIS ===== */
.avis-card {
    background: var(--blanc);
    border-radius: 10px;
    padding: 1.25rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
}
.avis-stars { display: flex; gap: 2px; }
.avis-text {
    font-size: 0.85rem;
    font-style: italic;
    color: #4b5563;
    line-height: 1.6;
    margin-bottom: 0.5rem;
}
.avis-auteur {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--noir);
    margin-bottom: 0;
}

/* ===== AVANT/APRÈS ===== */
.avant-apres-label {
    position: absolute;
    bottom: 0.5rem;
    left: 0.5rem;
    background: rgba(255,255,255,0.85);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    color: var(--noir);
}
.avant-apres-fleche {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: white;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    gap: 0;
}

/* ===== BLOG ===== */
.blog-card {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
}
.blog-card-img {
    width: 80px;
    height: 70px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
}
.blog-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.blog-card-img-placeholder {
    background: var(--rose-pale);
    width: 80px;
    height: 70px;
    border-radius: 6px;
    flex-shrink: 0;
}
.blog-card-body { flex: 1; }
.blog-card-cat {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--gris);
    display: block;
    margin-bottom: 0.25rem;
}
.blog-card-titre {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--noir);
    line-height: 1.3;
    margin-bottom: 0.4rem;
}

/* ===== LIEN SECTION ===== */
.section-link {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--rose);
    text-decoration: none;
    transition: opacity 0.2s;
}
.section-link:hover { opacity: 0.7; color: var(--rose); }
</style>
{% endblock %}

{% block content %}

    {# Hero #}
    <section class="hero-section position-relative overflow-hidden">

        {# Image de fond #}
        <div class="hero-bg" style="background-image: url('{{ asset('images/hero-banner.png') }}');"></div>

        {# Overlay dégradé pour lisibilité du texte #}
        <div class="hero-overlay"></div>

        <div class="container position-relative" style="z-index: 2;">
            <div class="row align-items-center" style="min-height: 560px;">
                <div class="col-lg-5 py-5">

                    {# Titre deux lignes #}
                    <h1 class="hero-title mb-3">
                        <span class="hero-title-rose">L'Essence</span><br>
                        <span class="hero-title-noir">d'une Peau Éclatante</span>
                    </h1>

                    <p class="hero-subtitle mb-5">
                        Soins experts, produits coréens sélectionnés<br>
                        pour leur efficacité, leur innovation<br>
                        et le respect de votre peau.
                    </p>

                    <div class="d-flex gap-3 flex-wrap">
                        <a href="{{ path('app_front_product_index') }}" class="btn btn-pink btn-hero d-flex align-items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                                <line x1="3" y1="6" x2="21" y2="6"/>
                                <path d="M16 10a4 4 0 0 1-8 0"/>
                            </svg>
                            Découvrir la boutique
                        </a>
                        <a href="https://share.google/XNtyVAzeKl9r4qIEV" target="_blank" rel="noopener noreferrer" class="btn btn-outline-rose btn-hero d-flex align-items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                            Réserver un soin
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Badge circulaire #}
        <div class="hero-badge">
            <div class="hero-badge-inner">
                <span class="hero-badge-icon">✦</span>
                <span class="hero-badge-line1">ANALYSE DE PEAU</span>
                <span class="hero-badge-line2">OFFERTE</span>
                <span class="hero-badge-line3">EN BOUTIQUE</span>
            </div>
        </div>

    </section>

    {# Mini-bandeau sous le hero #}
    <section class="hero-sub-banner py-3 bg-white border-bottom">
        <div class="container">
            <div class="row text-center g-3">
                <div class="col-6 col-md-3 d-flex align-items-center justify-content-center gap-2">
                    <span style="color: var(--rose);">✓</span>
                    <span class="small">Produits 100% authentiques</span>
                </div>
                <div class="col-6 col-md-3 d-flex align-items-center justify-content-center gap-2">
                    <span style="color: var(--rose);">✓</span>
                    <span class="small">Livraison rapide Colissimo</span>
                </div>
                <div class="col-6 col-md-3 d-flex align-items-center justify-content-center gap-2">
                    <span style="color: var(--rose);">✓</span>
                    <span class="small">Paiement sécurisé</span>
                </div>
                <div class="col-6 col-md-3 d-flex align-items-center justify-content-center gap-2">
                    <span style="color: var(--rose);">✓</span>
                    <span class="small">Retrait en boutique gratuit</span>
                </div>
            </div>
        </div>
    </section>

    {# Bandeau avantages #}
    <section class="py-4" style="background-color: var(--rose-pale);">
        <div class="container">
            <div class="row">

                {# Soins experts #}
                <div class="col-6 col-md-3 mb-3 mb-md-0">
                    <div class="d-flex align-items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;">
                            <path d="M12 2a9 9 0 0 1 0 18A9 9 0 0 1 12 2z"/>
                            <path d="M12 2c0 0-4 4-4 9s4 9 4 9"/>
                            <path d="M12 2c0 0 4 4 4 9s-4 9-4 9"/>
                            <path d="M3.6 9h16.8"/>
                            <path d="M3.6 15h16.8"/>
                        </svg>
                        <div>
                            <p class="mb-1" style="font-family: var(--font-corps); font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--noir);">SOINS EXPERTS</p>
                            <p class="mb-0" style="font-family: var(--font-corps); font-size: 0.8rem; color: var(--gris); line-height: 1.5;">Des protocoles ciblés pour répondre à chaque besoin de votre peau.</p>
                        </div>
                    </div>
                </div>

                {# Expertise K-Beauty #}
                <div class="col-6 col-md-3 mb-3 mb-md-0">
                    <div class="d-flex align-items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;">
                            <path d="M9 3H5a2 2 0 0 0-2 2v4"/>
                            <path d="M9 3h6"/>
                            <path d="M15 3h4a2 2 0 0 1 2 2v4"/>
                            <path d="M3 9v6"/>
                            <path d="M21 9v6"/>
                            <path d="M3 15v2a2 2 0 0 0 2 2h4"/>
                            <path d="M15 19h4a2 2 0 0 0 2-2v-2"/>
                            <path d="M9 19h6"/>
                            <circle cx="12" cy="11" r="2"/>
                            <path d="M12 13v5"/>
                        </svg>
                        <div>
                            <p class="mb-1" style="font-family: var(--font-corps); font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--noir);">EXPERTISE K-BEAUTY</p>
                            <p class="mb-0" style="font-family: var(--font-corps); font-size: 0.8rem; color: var(--gris); line-height: 1.5;">Des produits coréens rigoureusement sélectionnés pour des résultats visibles.</p>
                        </div>
                    </div>
                </div>

                {# Analyse de peau #}
                <div class="col-6 col-md-3 mb-3 mb-md-0">
                    <div class="d-flex align-items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;">
                            <circle cx="12" cy="8" r="5"/>
                            <path d="M8 8a4 4 0 0 1 8 0"/>
                            <path d="M9 13.5C9 16 10.3 18 12 18s3-2 3-4.5"/>
                            <path d="M12 18v3"/>
                            <path d="M9 21h6"/>
                        </svg>
                        <div>
                            <p class="mb-1" style="font-family: var(--font-corps); font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--noir);">ANALYSE DE PEAU OFFERTE</p>
                            <p class="mb-0" style="font-family: var(--font-corps); font-size: 0.8rem; color: var(--gris); line-height: 1.5;">Un diagnostic personnalisé grâce à notre technologie de pointe.</p>
                        </div>
                    </div>
                </div>

                {# Référence à Angers #}
                <div class="col-6 col-md-3">
                    <div class="d-flex align-items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;">
                            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                            <circle cx="12" cy="9" r="2.5"/>
                        </svg>
                        <div>
                            <p class="mb-1" style="font-family: var(--font-corps); font-size: 0.72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--noir);">RÉFÉRENCE À ANGERS</p>
                            <p class="mb-0" style="font-family: var(--font-corps); font-size: 0.8rem; color: var(--gris); line-height: 1.5;">Votre institut spécialisé en beauté coréenne au cœur d'Angers.</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    {# Nos soins experts #}
    <section class="py-5 bg-white">
        <div class="container">
            <h2 class="text-center mb-2" style="font-family: var(--font-titre); font-size: 1.8rem;">Nos soins experts</h2>
            <div class="text-center mb-5"><span style="display:inline-block;width:40px;height:2px;background:var(--rose);"></span></div>

            {% if services|length > 0 %}
            <div class="row g-4">
                {% for service in services %}
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="soin-card h-100">
                        <div class="soin-card-img">
                            {% if service.image %}
                                <img src="{{ asset('uploads/services/' ~ service.image) }}" alt="{{ service.titre }}">
                            {% else %}
                                <div class="soin-card-img-placeholder">
                                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2"><circle cx="12" cy="8" r="5"/><path d="M9 13.5C9 16 10.3 18 12 18s3-2 3-4.5"/></svg>
                                </div>
                            {% endif %}
                        </div>
                        <div class="soin-card-body">
                            <h6 class="soin-card-title">{{ service.titre|upper }}</h6>
                            <p class="soin-card-desc">{{ service.description|slice(0, 80) }}{% if service.description|length > 80 %}...{% endif %}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            {# Fallback avec 6 soins statiques si aucun en base #}
            <div class="row g-4">
                {% set soins_statiques = [
                    {titre: 'ACNÉ & IMPERFECTIONS', desc: 'Réduire les imperfections et retrouver une peau nette et équilibrée.'},
                    {titre: 'HYDRATATION & CONFORT', desc: 'Repulper, nourrir et apporter confort aux peaux déshydratées.'},
                    {titre: 'TACHES & TEINT IRRÉGULIER', desc: 'Un teint plus uniforme, plus lumineux et sans taches.'},
                    {titre: 'FERMETÉ & ÂGE CUTANÉ', desc: 'Lisser, raffermir et redonner de l\'éclat aux peaux matures.'},
                    {titre: 'PEAU SENSIBLE & APAISEMENT', desc: 'Apaiser, calmer et renforcer les peaux sensibles et réactives.'},
                    {titre: 'ÉPILATION LASER & MASSAGES', desc: 'Des technologies avancées et des massages pour votre bien-être.'},
                ] %}
                {% for soin in soins_statiques %}
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="soin-card h-100">
                        <div class="soin-card-img soin-card-img-placeholder">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2"><circle cx="12" cy="8" r="5"/><path d="M9 13.5C9 16 10.3 18 12 18s3-2 3-4.5"/><path d="M12 18v3"/><path d="M9 21h6"/></svg>
                        </div>
                        <div class="soin-card-body">
                            <h6 class="soin-card-title">{{ soin.titre }}</h6>
                            <p class="soin-card-desc">{{ soin.desc }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endif %}

            <div class="text-center mt-5">
                <a href="https://www.fresha.com/fr/a/nice-kcream-beauty-angers-4-place-pierre-mendes-france-mh3yfeql"
                    target="_blank" rel="noopener"
                    class="btn btn-pink px-4 py-2">VOIR TOUS NOS SOINS</a>
            </div>
        </div>
    </section>

    {# Produits phares #}
    <section class="py-5">
        <div class="container">
            <h2 class="mb-2" style="font-family: var(--font-titre); font-size: 1.8rem;">Produits phares</h2>
            <div class="mb-4"><span style="display:inline-block;width:40px;height:2px;background:var(--rose);"></span></div>

            <div class="row g-3">
                {# Produits #}
                {% for product in featuredProducts %}
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="produit-card position-relative">
                        {# Badges #}
                        {% if product.isNouveaute %}
                            <span class="produit-badge produit-badge-new">NOUVEAU</span>
                        {% endif %}
                        {% if product.prixPromo %}
                            {% set discount = ((product.prix - product.prixPromo) / product.prix * 100)|round %}
                            <span class="produit-badge produit-badge-promo" style="{% if product.isNouveaute %}top: 2rem;{% endif %}">-{{ discount }}%</span>
                        {% endif %}

                        {# Image #}
                        <a href="{{ path('app_front_product_show', {slug: product.slug}) }}" class="produit-card-img-link">
                            <div class="produit-card-img">
                                {% if product.mainImage %}
                                    <img src="{{ asset('uploads/products/' ~ product.mainImage.filename) }}" alt="{{ product.nom }}">
                                {% else %}
                                    <div class="produit-card-img-placeholder">
                                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                                    </div>
                                {% endif %}
                            </div>
                        </a>

                        {# Infos #}
                        <div class="produit-card-body">
                            <p class="produit-card-marque">{{ product.category ? product.category.nom : '' }}</p>
                            <a href="{{ path('app_front_product_show', {slug: product.slug}) }}" class="produit-card-nom">{{ product.nom }}</a>
                            <div class="produit-card-prix-row">
                                <div>
                                    {% if product.prixPromo %}
                                        <span class="produit-card-prix-barre">{{ product.prix|number_format(2, ',', ' ') }} €</span>
                                        <span class="produit-card-prix-promo">{{ product.prixPromo|number_format(2, ',', ' ') }} €</span>
                                    {% else %}
                                        <span class="produit-card-prix">{{ product.prix|number_format(2, ',', ' ') }} €</span>
                                    {% endif %}
                                </div>
                                    <form action="{{ path('app_front_cart_add', {id: product.id}) }}" method="POST">
                                        <button type="submit" class="produit-card-panier" title="Ajouter au panier">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                                            </svg>
                                        </button>
                                    </form>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}

                {# Bloc Coffrets K-Beauty #}
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="coffret-card h-100">
                        <p class="coffret-card-label">Coffrets K-Beauty</p>
                        <p class="coffret-card-desc">Des routines complètes pour prendre soin de votre peau au quotidien.</p>
                        <img src="{{ asset('images/coffret.png') }}" alt="Coffrets K-Beauty" style="width:100%; border-radius:6px; margin-bottom:1rem; object-fit:cover;">
                        <a href="{{ path('app_front_coffret_index') }}" class="btn btn-pink btn-sm px-3">
                            DÉCOUVRIR LES COFFRETS
                        </a>
                    </div>
                </div>

            </div>

            <div class="text-center mt-4">
                <a href="{{ path('app_front_product_index') }}" class="btn btn-pink px-4 py-2">VOIR TOUTE LA BOUTIQUE</a>
            </div>
        </div>
    </section>

    {# Avis / Avant-Après / Blog #}
    <section class="py-5" style="background-color: #fafafa;">
        <div class="container">
            <div class="row g-5">

                {# Avis clients #}
                <div class="col-md-4">
                    <h4 class="mb-2" style="font-family: var(--font-titre); font-size: 1.3rem;">Avis de nos clientes</h4>
                    <div class="mb-4"><span style="display:inline-block;width:40px;height:2px;background:var(--rose);"></span></div>

                    {% if reviews|length > 0 %}
                        {% for review in reviews %}
                        <div class="avis-card mb-3">
                            <div class="avis-stars mb-2">
                                {% for i in 1..5 %}
                                    <svg width="14" height="14" viewBox="0 0 24 24"
                                        fill="{{ i <= review.note ? '#f4c430' : '#e5e7eb' }}" stroke="none">
                                        <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                                    </svg>
                                {% endfor %}
                            </div>
                            {% if review.commentaire %}
                                <p class="avis-text">"{{ review.commentaire }}"</p>
                            {% endif %}
                            <p class="avis-auteur">{{ review.auteur }}</p>
                        </div>
                        {% endfor %}

                        <a href="https://www.google.com/maps/search/?api=1&query=Nice+K%27Cream+Beauty+Angers"
                        target="_blank" rel="noopener"
                        class="section-link">VOIR TOUS LES AVIS →</a>
                    {% else %}
                        <p class="text-muted small">Aucun avis pour le moment.</p>
                    {% endif %}
                </div>

                {# Avant / Après #}
                <div class="col-md-4">
                    <h4 class="mb-2" style="font-family: var(--font-titre); font-size: 1.3rem;">Avant / Après</h4>
                    <div class="mb-4"><span style="display:inline-block;width:40px;height:2px;background:var(--rose);"></span></div>
                    {% if beforeAfters|length > 0 %}
                        <div class="avant-apres-slider position-relative">
                            {% for ba in beforeAfters %}
                            <div class="avant-apres-item {% if not loop.first %}d-none{% endif %}">
                                <div class="avant-apres-imgs position-relative" style="border-radius:10px; overflow:hidden;">
                                    <div class="row g-0">
                                        <div class="col-6 position-relative">
                                            <img src="{{ asset('uploads/before_after/' ~ ba.imageAvant) }}"
                                                style="width:100%; height:220px; object-fit:cover;" alt="Avant">
                                            <span class="avant-apres-label">AVANT</span>
                                        </div>
                                        <div class="col-6 position-relative">
                                            <img src="{{ asset('uploads/before_after/' ~ ba.imageApres) }}"
                                                style="width:100%; height:220px; object-fit:cover;" alt="Après">
                                            <span class="avant-apres-label" style="right:0.5rem; left:auto;">APRÈS</span>
                                        </div>
                                    </div>
                                    <div class="avant-apres-fleche">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
                                    </div>
                                </div>
                                {% if ba.titre %}
                                    <p class="small fw-bold mt-2 mb-0" style="color:var(--noir);">{{ ba.titre }}</p>
                                {% endif %}
                            </div>
                            {% endfor %}
                        </div>
                        <a href="{{ path('app_front_galerie') }}" class="section-link mt-3 d-block">VOIR LA GALERIE →</a>
                    {% else %}
                        {# Fallback image statique #}
                        <div class="avant-apres-imgs position-relative" style="border-radius:10px; overflow:hidden;">
                            <img src="{{ asset('images/avant_apres.png') }}"
                                style="width:100%; border-radius:10px; object-fit:cover;" alt="Avant / Après">
                            <div class="avant-apres-fleche">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
                            </div>
                        </div>
                        <a href="{{ path('app_front_galerie') }}" class="section-link mt-3 d-block">VOIR LA GALERIE →</a>
                    {% endif %}
                </div>

                {# Blog #}
                <div class="col-md-4">
                    <h4 class="mb-2" style="font-family: var(--font-titre); font-size: 1.3rem;">Nos derniers conseils</h4>
                    <div class="mb-4"><span style="display:inline-block;width:40px;height:2px;background:var(--rose);"></span></div>
                    {% if blogPosts|length > 0 %}
                        <div class="row g-3">
                            {% for post in blogPosts %}
                            <div class="col-12">
                                <div class="blog-card">
                                    {% if post.image %}
                                        <div class="blog-card-img">
                                            <img src="{{ asset('uploads/blog/' ~ post.image) }}" alt="{{ post.titre }}">
                                        </div>
                                    {% else %}
                                        <div class="blog-card-img blog-card-img-placeholder"></div>
                                    {% endif %}
                                    <div class="blog-card-body">
                                        <span class="blog-card-cat">{{ post.categorie }}</span>
                                        <p class="blog-card-titre">{{ post.titre }}</p>
                                        <a href="{{ path('app_front_blog_index') }}" class="section-link">Lire l'article →</a>
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                        <a href="{{ path('app_front_blog_index') }}" class="section-link mt-3 d-block">VOIR TOUS LES ARTICLES →</a>
                    {% else %}
                        <p class="text-muted small">Aucun article pour le moment.</p>
                    {% endif %}
                </div>

            </div>
        </div>
    </section>

    {# Bandeau final #}
    <section class="py-4 bg-white border-top">
        <div class="container">
            <div class="row g-3 text-center">

                <div class="col-6 col-md-3">
                    <div class="d-flex flex-column align-items-center gap-2">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="3" width="15" height="13" rx="2"/>
                            <path d="M16 8h4l3 5v3h-7V8z"/>
                            <circle cx="5.5" cy="18.5" r="2.5"/>
                            <circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                        <div>
                            <p class="mb-0" style="font-size:0.72rem; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--noir);">LIVRAISON OFFERTE</p>
                            <p class="mb-0" style="font-size:0.8rem; color:var(--gris);">Dès 70€ d'achat en France métropolitaine</p>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="d-flex flex-column align-items-center gap-2">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                            <polyline points="9 22 9 12 15 12 15 22"/>
                        </svg>
                        <div>
                            <p class="mb-0" style="font-size:0.72rem; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--noir);">RETRAIT EN BOUTIQUE</p>
                            <p class="mb-0" style="font-size:0.8rem; color:var(--gris);">À Angers sous 24/48h</p>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="d-flex flex-column align-items-center gap-2">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                        <div>
                            <p class="mb-0" style="font-size:0.72rem; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--noir);">PAIEMENT SÉCURISÉ</p>
                            <p class="mb-0" style="font-size:0.8rem; color:var(--gris);">Stripe, Apple Pay, Google Pay, CB</p>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="d-flex flex-column align-items-center gap-2">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        <div>
                            <p class="mb-0" style="font-size:0.72rem; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--noir);">SERVICE CLIENT</p>
                            <p class="mb-0" style="font-size:0.8rem; color:var(--gris);">À votre écoute du lundi au samedi</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

{% endblock %}