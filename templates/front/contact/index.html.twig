                                    Instagram
                                </a>
                                <a href="https://www.tiktok.com/search?q=nice+k+cream+beauty" target="_blank" rel="noopener" class="social-btn social-btn-tiktok">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.75a4.85 4.85 0 01-1.01-.06z"/></svg>
                                    TikTok
                                </a>
                                <a href="https://wa.me/33759691663" target="_blank" rel="noopener" class="social-btn social-btn-wa">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                                    WhatsApp
                                </a>
                            </div>
                        </div>

                        <div class="contact-card">
                            <h5>Horaires d'ouverture</h5>
                            <div class="horaire-row"><span class="jour">Lundi</span><span>10:30–12:30 / 13:30–18:30</span></div>
                            <div class="horaire-row"><span class="jour">Mardi</span><span>10:30–12:30 / 13:30–18:30</span></div>
                            <div class="horaire-row"><span class="jour">Mercredi</span><span>10:30–12:30 / 13:30–18:30</span></div>
                            <div class="horaire-row"><span class="jour">Jeudi</span><span>10:30–12:30 / 13:30–18:30</span></div>
                            <div class="horaire-row"><span class="jour">Vendredi</span><span>10:30–12:30 / 13:30–18:30</span></div>
                            <div class="horaire-row"><span class="jour">Samedi</span><span>10:30–12:30 / 13:30–18:30</span></div>
                            <div class="horaire-row"><span class="jour" style="color:var(--gris);">Dimanche</span><span class="ferme">Fermé</span></div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

{% endblock %}