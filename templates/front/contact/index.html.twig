{% extends 'front/base.html.twig' %}

{% block title %}Contact — Nice K'Cream Beauty{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .contact-hero {
        background-color: var(--rose-pale);
        padding: 3rem 0 2rem;
        text-align: center;
    }
    .contact-hero h1 {
        font-family: var(--font-titre);
        font-size: 2.2rem;
        font-weight: 600;
        color: var(--noir);
        margin-bottom: 0.5rem;
    }
    .contact-hero p {
        color: var(--gris);
        font-size: 0.95rem;
    }
    .contact-card {
        background: var(--blanc);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 2rem;
    }
    .contact-card h5 {
        font-family: var(--font-titre);
        font-size: 1.1rem;
        color: var(--noir);
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid var(--rose-pale);
    }
    .contact-info-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        font-size: 0.9rem;
        color: var(--noir);
    }
    .contact-info-icon {
        color: var(--rose);
        font-size: 1.1rem;
        margin-top: 2px;
        flex-shrink: 0;
    }
    .horaire-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        padding: 0.4rem 0;
        border-bottom: 1px solid var(--rose-pale);
        color: var(--noir);
    }
    .horaire-row:last-child { border-bottom: none; }
    .horaire-row .jour { font-weight: 500; }
    .horaire-row .ferme { color: var(--gris); font-style: italic; }
    .social-links { display: flex; gap: 0.75rem; margin-top: 1rem; flex-wrap: wrap; }
    .social-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        letter-spacing: 0.3px;
    }
    .social-btn-ig {
        background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
        color: white !important;
    }
    .social-btn-tiktok {
        background: #000000;
        color: white !important;
    }
    .social-btn-wa {
        background: #25D366;
        color: white !important;
    }
    .social-btn:hover { transform: translateY(-2px); opacity: 0.9; }
    .form-label {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: var(--gris);
        margin-bottom: 0.4rem;
    }
    .form-control, .form-select {
        border: 1.5px solid #e5e7eb;
        border-radius: 6px;
        font-size: 0.9rem;
        padding: 0.65rem 0.9rem;
        transition: border-color 0.2s;
    }
    .form-control:focus, .form-select:focus {
        border-color: var(--rose);
        box-shadow: 0 0 0 3px rgba(201, 95, 131, 0.1);
    }
    .alert-success-custom {
        background: #f0fdf4;
        border: 1.5px solid #86efac;
        border-radius: 8px;
        padding: 1rem 1.25rem;
        color: #166534;
        font-size: 0.9rem;
    }
    .alert-error-custom {
        background: #fef2f2;
        border: 1.5px solid #fca5a5;
        border-radius: 8px;
        padding: 1rem 1.25rem;
        color: #991b1b;
        font-size: 0.9rem;
    }

    /* Colonne droite scrollable si trop haute */
    .contact-right-col {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
</style>
{% endblock %}

{% block content %}

    {# Hero #}
    <section class="contact-hero">
        <div class="container">
            <h1>Contactez-nous</h1>
            <div class="mb-2"><span style="display:inline-block;width:40px;height:2px;background:var(--rose);"></span></div>
            <p>Une question, une demande de renseignement ? Nous sommes là pour vous.</p>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row g-4 align-items-start">

                {# Colonne gauche — Formulaire #}
                <div class="col-lg-7">
                    <div class="contact-card">
                        <h5>Envoyer un message</h5>

                        {% if success %}
                            <div class="alert-success-custom mb-4">
                                ✅ Votre message a bien été envoyé ! Nous vous répondrons dans les plus brefs délais.
                            </div>
                        {% endif %}

                        {% if error %}
                            <div class="alert-error-custom mb-4">
                                ⚠️ {{ error }}
                            </div>
                        {% endif %}

                        {% if not success %}
                        <form method="POST" action="{{ path('app_front_contact') }}">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Votre nom *</label>
                                    <input type="text" name="nom" class="form-control"
                                        placeholder="Dupont Marie" required
                                        value="{{ app.request.request.get('nom') }}">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Votre email *</label>
                                    <input type="email" name="email" class="form-control"
                                        placeholder="marie@exemple.fr" required
                                        value="{{ app.request.request.get('email') }}">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Sujet *</label>
                                    <select name="sujet" class="form-select" required>
                                        <option value="">Choisir un sujet...</option>
                                        <option value="Question sur un produit" {% if app.request.request.get('sujet') == 'Question sur un produit' %}selected{% endif %}>Question sur un produit</option>
                                        <option value="Réservation de soin" {% if app.request.request.get('sujet') == 'Réservation de soin' %}selected{% endif %}>Réservation de soin</option>
                                        <option value="Suivi de commande" {% if app.request.request.get('sujet') == 'Suivi de commande' %}selected{% endif %}>Suivi de commande</option>
                                        <option value="Retour / Échange" {% if app.request.request.get('sujet') == 'Retour / Échange' %}selected{% endif %}>Retour / Échange</option>
                                        <option value="Partenariat" {% if app.request.request.get('sujet') == 'Partenariat' %}selected{% endif %}>Partenariat</option>
                                        <option value="Autre" {% if app.request.request.get('sujet') == 'Autre' %}selected{% endif %}>Autre</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Message *</label>
                                    <textarea name="message" class="form-control" rows="6"
                                        placeholder="Écrivez votre message ici..." required>{{ app.request.request.get('message') }}</textarea>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-pink w-100" style="padding: 0.75rem;">
                                        Envoyer le message
                                    </button>
                                </div>
                            </div>
                        </form>
                        {% endif %}
                    </div>
                </div>

                {# Colonne droite — Infos #}
                <div class="col-lg-5">
                    <div class="contact-right-col">

                        <div class="contact-card">
                            <h5>Nos coordonnées</h5>

                            <div class="contact-info-item">
                                <span class="contact-info-icon">📍</span>
                                <div>
                                    4 Place Pierre Mendès France<br>
                                    49100 Angers, France
                                </div>
                            </div>

                            <div class="contact-info-item">
                                <span class="contact-info-icon">📞</span>
                                <div>
                                    <a href="tel:+33759691663" style="color: var(--noir); text-decoration: none;">
                                        +33 7 59 69 16 63
                                    </a>
                                </div>
                            </div>

                            <div class="contact-info-item">
                                <span class="contact-info-icon">✉️</span>
                                <div>
                                    <a href="mailto:nicekreambeauty@gmail.com" style="color: var(--rose); text-decoration: none;">
                                        nicekreambeauty@gmail.com
                                    </a>
                                </div>
                            </div>

                            <div class="contact-info-item">
                                <span class="contact-info-icon">💬</span>
                                <div>
                                    <a href="https://wa.me/33759691663" target="_blank" style="color: #25D366; text-decoration: none; font-weight: 600;">
                                        WhatsApp : +33 7 59 69 16 63
                                    </a>
                                </div>
                            </div>

                            <div class="social-links">
                                <a href="https://www.instagram.com/nicekcreambeauty" target="_blank" rel="noopener" class="social-btn social-btn-ig">
