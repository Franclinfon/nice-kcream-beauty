{% extends 'front/base.html.twig' %}

{% block title %}À propos — Nice K'Cream Beauty Angers{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* ===== HERO ===== */
    .apropos-hero {
        position: relative;
        height: 480px;
        background: linear-gradient(135deg, var(--rose-pale) 0%, #fdf6f0 100%);
        display: flex;
        align-items: center;
        overflow: hidden;
    }
    .apropos-hero::before {
        content: '';
        position: absolute;
        top: -100px; right: -100px;
        width: 500px; height: 500px;
        border-radius: 50%;
        background: rgba(201,95,131,0.06);
    }
    .apropos-hero-content { position: relative; z-index: 1; }
    .apropos-hero h1 {
        font-family: var(--font-titre);
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        color: var(--noir);
        line-height: 1.2;
        margin-bottom: 1rem;
    }
    .apropos-hero h1 span { color: var(--rose); font-style: italic; }
    .apropos-hero p {
        font-size: 1.05rem;
        color: #4b5563;
        margin-bottom: 2rem;
        line-height: 1.7;
    }
    .apropos-hero-img {
        border-radius: 16px;
        overflow: hidden;
        height: 380px;
    }
    .apropos-hero-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .apropos-hero-img-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #fde8f0, var(--rose-pale));
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ===== SECTION TITLES ===== */
    .section-title-left {
        font-family: var(--font-titre);
        font-size: 1.8rem;
        font-weight: 600;
        color: var(--noir);
        margin-bottom: 0.5rem;
    }
    .section-title-center {
        font-family: var(--font-titre);
        font-size: 1.8rem;
        font-weight: 600;
        color: var(--noir);
        margin-bottom: 0.5rem;
        text-align: center;
    }
    .divider-left {
        display: inline-block;
        width: 40px;
        height: 2px;
        background: var(--rose);
        margin-bottom: 1.5rem;
    }
    .divider-center {
        display: block;
        width: 40px;
        height: 2px;
        background: var(--rose);
        margin: 0 auto 1.5rem;
    }

    /* ===== HISTOIRE ===== */
    .histoire-section { padding: 5rem 0; background: white; }
    .histoire-text {
        font-size: 1rem;
        color: #4b5563;
        line-height: 1.9;
    }
    .histoire-text p { margin-bottom: 1.25rem; }
    .histoire-highlight {
        background: var(--rose-pale);
        border-left: 4px solid var(--rose);
        padding: 1.25rem 1.5rem;
        border-radius: 0 8px 8px 0;
        font-style: italic;
        font-size: 1rem;
        color: var(--noir);
        margin: 1.5rem 0;
        line-height: 1.7;
    }
    .histoire-img {
        border-radius: 16px;
        overflow: hidden;
        height: 350px;
    }
    .histoire-img img { width: 100%; height: 100%; object-fit: cover; }
    .histoire-img-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, var(--rose-pale), #fdf6f0);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ===== VALEURS ===== */
    .valeurs-section { padding: 5rem 0; background: #fafafa; }
    .valeur-card {
        background: white;
        border-radius: 12px;
        padding: 2rem 1.5rem;
        text-align: center;
        box-shadow: 0 2px 15px rgba(0,0,0,0.05);
        height: 100%;
        transition: all 0.3s ease;
    }
    .valeur-card:hover {
        box-shadow: 0 8px 30px rgba(201,95,131,0.12);
        transform: translateY(-3px);
    }
    .valeur-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        display: block;
    }
    .valeur-title {
        font-family: var(--font-titre);
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--noir);
        margin-bottom: 0.75rem;
    }
    .valeur-desc { font-size: 0.85rem; color: var(--gris); line-height: 1.6; margin: 0; }

    /* ===== APPROCHE ===== */
    .approche-section { padding: 5rem 0; background: white; }
    .etape-approche {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
    }
    .etape-approche-num {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--rose);
        color: white;
        font-family: var(--font-titre);
        font-size: 1.3rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        box-shadow: 0 4px 15px rgba(201,95,131,0.3);
    }
    .etape-approche-title {
        font-family: var(--font-corps);
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--noir);
        letter-spacing: 0.5px;
        margin-bottom: 0.4rem;
    }
    .etape-approche-desc { font-size: 0.78rem; color: var(--gris); line-height: 1.5; margin: 0; }
    .etape-fleche {
        display: flex;
        align-items: center;
        justify-content: center;
        padding-top: 1.5rem;
    }

    /* ===== CHIFFRES ===== */
    .chiffres-section { padding: 5rem 0; background: var(--rose-pale); }
    .chiffre-card {
        text-align: center;
        padding: 2rem 1rem;
    }
    .chiffre-icon { font-size: 2rem; margin-bottom: 0.75rem; display: block; }
    .chiffre-value {
        font-family: var(--font-titre);
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--rose);
        margin-bottom: 0.4rem;
    }
    .chiffre-label { font-size: 0.85rem; color: var(--gris); }

    /* ===== ENGAGEMENTS ===== */
    .engagements-section { padding: 5rem 0; background: white; }
    .engagement-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 0;
        font-size: 0.9rem;
        color: var(--noir);
        border-bottom: 1px solid var(--rose-pale);
    }
    .engagement-item:last-child { border-bottom: none; }
    .engagement-check {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--rose-pale);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* ===== LOCALISATION ===== */
    .localisation-section { padding: 5rem 0; background: #fafafa; }
    .info-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .info-item-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: var(--rose-pale);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .info-item-title {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--gris);
        margin-bottom: 0.2rem;
    }
    .info-item-value { font-size: 0.9rem; color: var(--noir); margin: 0; }
    .info-item-value a { color: var(--rose); text-decoration: none; }
    .horaire-item {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--rose-pale);
        font-size: 0.85rem;
    }
    .horaire-item:last-child { border-bottom: none; }
    .horaire-jour { font-weight: 500; color: var(--noir); }
    .horaire-heure { color: var(--gris); }
    .horaire-ferme { color: #d1d5db; font-style: italic; }

    /* ===== CTA ===== */
    .apropos-cta {
        padding: 5rem 0;
        background: var(--noir);
        text-align: center;
    }
    .apropos-cta h2 {
        font-family: var(--font-titre);
        font-size: 2rem;
        color: white;
        margin-bottom: 1rem;
    }
    .apropos-cta h2 span { color: var(--rose); font-style: italic; }
    .apropos-cta p { color: rgba(255,255,255,0.7); margin-bottom: 2rem; }
</style>
{% endblock %}

