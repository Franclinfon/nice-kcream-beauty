{% extends 'front/base.html.twig' %}

{% block title %}Mes adresses — Nice K'Cream Beauty{% endblock %}

{% block content %}
    <div class="container py-5">
        <div class="row">
            <div class="col-md-3 mb-4">
                <div class="list-group">
                    <a href="{{ path('app_front_account_index') }}" class="list-group-item list-group-item-action">
                        Mon profil
                    </a>
                    <a href="{{ path('app_front_account_addresses') }}" class="list-group-item list-group-item-action active" style="background-color: #e0769a; border-color: #e0769a;">
                        Mes adresses
                    </a>
                    <a href="{{ path('app_logout') }}" class="list-group-item list-group-item-action text-danger">
                        Se déconnecter
                    </a>
                </div>
            </div>

            <div class="col-md-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="mb-0">Mes adresses</h1>
                    <a href="{{ path('app_front_account_address_new') }}" class="btn btn-pink">Ajouter une adresse</a>
                </div>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">{{ message }}</div>
                {% endfor %}

                {% for address in addresses %}
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6 class="fw-bold">{{ address.label }} {% if address.isDefault %}<span class="badge bg-secondary">Par défaut</span>{% endif %}</h6>
                                    <p class="mb-0 text-muted">
                                        {{ address.rue }}{% if address.complement %}, {{ address.complement }}{% endif %}<br>
                                        {{ address.codePostal }} {{ address.ville }}<br>
                                        {{ address.pays }}
                                    </p>
                                </div>
                                <form action="{{ path('app_front_account_address_delete', {id: address.id}) }}" method="post" onsubmit="return confirm('Supprimer cette adresse ?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-muted">Aucune adresse enregistrée pour le moment.</p>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}