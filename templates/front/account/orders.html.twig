{% extends 'front/base.html.twig' %}

{% block title %}Mes commandes — Nice K'Cream Beauty{% endblock %}

{% block content %}
    <div class="container py-5">
        <div class="row">
            <div class="col-md-3 mb-4">
                <div class="list-group">
                    <a href="{{ path('app_front_account_index') }}" class="list-group-item list-group-item-action">
                        Mon profil
                    </a>
                    <a href="{{ path('app_front_account_orders') }}" class="list-group-item list-group-item-action active" style="background-color: #e0769a; border-color: #e0769a;">
                        Mes commandes
                    </a>
                    <a href="{{ path('app_front_account_addresses') }}" class="list-group-item list-group-item-action">
                        Mes adresses
                    </a>
                    <a href="{{ path('app_logout') }}" class="list-group-item list-group-item-action text-danger">
                        Se déconnecter
                    </a>
                </div>
            </div>

            <div class="col-md-9">
                <h1 class="mb-4">Mes commandes</h1>

                {% if orders|length > 0 %}
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Numéro</th>
                                    <th>Date</th>
                                    <th>Statut</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for order in orders %}
                                    <tr>
                                        <td><strong>{{ order.numeroCommande }}</strong></td>
                                        <td>{{ order.createdAt|date('d/m/Y') }}</td>
                                        <td>
                                            {% if order.statut == 'payee' %}
                                                <span class="badge bg-success">Payée</span>
                                            {% elseif order.statut == 'en_attente_paiement' %}
                                                <span class="badge bg-warning text-dark">En attente de paiement</span>
                                            {% elseif order.statut == 'en_preparation' %}
                                                <span class="badge bg-info text-dark">En préparation</span>
                                            {% elseif order.statut == 'expediee' %}
                                                <span class="badge bg-primary">Expédiée</span>
                                            {% elseif order.statut == 'livree' %}
                                                <span class="badge bg-success">Livrée</span>
                                            {% elseif order.statut == 'annulee' %}
                                                <span class="badge bg-danger">Annulée</span>
                                            {% else %}
                                                <span class="badge bg-secondary">{{ order.statut }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="fw-bold" style="color: #c95f83;">{{ order.montantTotal|number_format(2, ',', ' ') }} €</td>
                                        <td>
                                            <a href="{{ path('app_front_account_order_show', {id: order.id}) }}" class="btn btn-sm btn-outline-dark">
                                                Voir le détail
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-muted">Vous n'avez pas encore passé de commande.</p>
                    <a href="{{ path('app_front_product_index') }}" class="btn btn-pink">Découvrir la boutique</a>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}