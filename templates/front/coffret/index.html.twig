{% extends 'front/base.html.twig' %}

{% block title %}Coffrets K-Beauty — Nice K'Cream Beauty{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .coffret-hero {
        background: linear-gradient(135deg, var(--rose-pale) 0%, #fdf6f0 100%);
        padding: 4rem 0 3rem;
        text-align: center;
    }
    .coffret-hero h1 {
        font-family: var(--font-titre);
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--noir);
        margin-bottom: 0.5rem;
    }
    .coffret-hero h1 span { color: var(--rose); font-style: italic; }
    .coffret-hero p { color: var(--gris); font-size: 0.95rem; }

    .coffret-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        transition: all 0.3s ease;
        height: 100%;
    }
    .coffret-card:hover {
        box-shadow: 0 12px 40px rgba(201,95,131,0.12);
        transform: translateY(-4px);
    }
    .coffret-card-img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        cursor: pointer;
    }
    .coffret-card-body { padding: 1.5rem; }
    .coffret-card-nom {
        font-family: var(--font-titre);
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--noir);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }
    .coffret-card-nom svg {
        transition: transform 0.3s ease;
        flex-shrink: 0;
        color: var(--rose);
    }
    .coffret-card-nom.open svg { transform: rotate(180deg); }
    .coffret-card-prix {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--rose);
        margin-bottom: 1rem;
    }
    .coffret-details {
        display: none;
        border-top: 1px solid var(--rose-pale);
        padding-top: 1rem;
        margin-top: 1rem;
    }
    .coffret-details.open { display: block; }
    .coffret-desc {
        font-size: 0.85rem;
        color: var(--gris);
        line-height: 1.6;
        margin-bottom: 1rem;
    }
    .coffret-products-title {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--noir);
        margin-bottom: 0.75rem;
    }
    .coffret-product-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid #f9f9f9;
    }
    .coffret-product-item:last-child { border-bottom: none; }
    .coffret-product-img {
        width: 44px;
        height: 44px;
        border-radius: 6px;
        object-fit: cover;
        background: var(--rose-pale);
        flex-shrink: 0;
    }
    .coffret-product-img-placeholder {
        width: 44px;
        height: 44px;
        border-radius: 6px;
        background: var(--rose-pale);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .coffret-product-nom {
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--noir);
    }
    .coffret-product-prix {
        font-size: 0.78rem;
        color: var(--gris);
    }
    .btn-coffret {
        width: 100%;
        padding: 0.75rem;
        margin-top: 1rem;
    }
</style>
{% endblock %}

{% block content %}

    <section class="coffret-hero">
        <div class="container">
            <h1>Coffrets <span>K-Beauty</span></h1>
            <div class="mb-3"><span style="display:inline-block;width:40px;height:2px;background:var(--rose);"></span></div>
            <p>Des routines complètes soigneusement sélectionnées pour prendre soin de votre peau au quotidien.</p>
        </div>
    </section>

    <section class="py-5" style="background:#fafafa;">
        <div class="container">
            {% if coffrets|length > 0 %}
            <div class="row g-4">
                {% for coffret in coffrets %}
                <div class="col-md-4">
                    <div class="coffret-card">
                        <img src="{{ asset('images/coffret.png') }}"
                             alt="{{ coffret.nom }}"
                             class="coffret-card-img"
                             onclick="toggleCoffret({{ coffret.id }})">

                        <div class="coffret-card-body">
                            <div class="coffret-card-nom" id="nom-{{ coffret.id }}" onclick="toggleCoffret({{ coffret.id }})">
                                {{ coffret.nom }}
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="6 9 12 15 18 9"/>
                                </svg>
                            </div>
                            <div class="coffret-card-prix">{{ coffret.prix|number_format(2, ',', ' ') }} €</div>

                            {# Détails dépliables #}
                            <div class="coffret-details" id="details-{{ coffret.id }}">
                                {% if coffret.description %}
                                    <p class="coffret-desc">{{ coffret.description }}</p>
                                {% endif %}

                                {% if coffret.products|length > 0 %}
                                    <p class="coffret-products-title">Produits inclus</p>
                                    {% for product in coffret.products %}
                                    <div class="coffret-product-item">
                                        {% if product.mainImage %}
                                            <img src="{{ asset('uploads/products/' ~ product.mainImage.filename) }}"
                                                 alt="{{ product.nom }}"
                                                 class="coffret-product-img">
                                        {% else %}
                                            <div class="coffret-product-img-placeholder">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                                            </div>
                                        {% endif %}
                                        <div>
                                            <p class="coffret-product-nom mb-0">{{ product.nom }}</p>
                                            <p class="coffret-product-prix mb-0">{{ product.prix|number_format(2, ',', ' ') }} €</p>
                                        </div>
                                    </div>
                                    {% endfor %}
                                {% endif %}

                                <form action="{{ path('app_front_coffret_add', {id: coffret.id}) }}" method="POST">
                                    <button type="submit" class="btn btn-pink btn-coffret">
                                        🛒 Ajouter au panier — {{ coffret.prix|number_format(2, ',', ' ') }} €
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

            {% else %}
            <div class="text-center py-5">
                <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="1" style="opacity:0.3; margin-bottom:1.5rem;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                <h3 style="font-family:var(--font-titre); color:var(--noir);">Aucun coffret disponible</h3>
                <p class="text-muted">Nos coffrets K-Beauty arrivent bientôt !</p>
                <a href="{{ path('app_front_product_index') }}" class="btn btn-pink mt-2">Voir la boutique</a>
            </div>
            {% endif %}
        </div>
    </section>

    <script>
    function toggleCoffret(id) {
        const details = document.getElementById('details-' + id);
        const nom = document.getElementById('nom-' + id);
        details.classList.toggle('open');
        nom.classList.toggle('open');
    }
    </script>

{% endblock %}