{% extends 'front/base.html.twig' %}

{% block title %}Créer un compte — Nice K'Cream Beauty{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .auth-card {
        background: white;
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 4px 30px rgba(0,0,0,0.07);
    }
    .auth-title {
        font-family: var(--font-titre);
        font-size: 2rem;
        font-weight: 700;
        color: var(--noir);
        margin-bottom: 0.25rem;
    }
    .auth-subtitle {
        font-size: 0.85rem;
        color: var(--gris);
        margin-bottom: 2rem;
    }
    .auth-label {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: var(--gris);
        margin-bottom: 0.4rem;
        display: block;
    }
    .auth-input {
        width: 100%;
        border: 1.5px solid #e5e7eb;
        border-radius: 6px;
        font-size: 0.9rem;
        padding: 0.65rem 0.9rem;
        transition: border-color 0.2s;
        outline: none;
        font-family: var(--font-corps);
    }
    .auth-input:focus {
        border-color: var(--rose);
        box-shadow: 0 0 0 3px rgba(201, 95, 131, 0.1);
    }
</style>
{% endblock %}

{% block content %}
<div class="container py-5" style="background: #fafafa; min-height: 80vh;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="auth-card">
                <h1 class="auth-title">Créer un compte</h1>
                <p class="auth-subtitle">Rejoignez la communauté Nice K'Cream Beauty</p>

                {{ form_errors(registrationForm) }}
                {{ form_start(registrationForm, {attr: {novalidate: 'novalidate'}}) }}

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="auth-label">Prénom *</label>
                            {{ form_widget(registrationForm.prenom, {attr: {class: 'auth-input', placeholder: 'Marie'}}) }}
                            {{ form_errors(registrationForm.prenom) }}
                        </div>
                        <div class="col-6">
                            <label class="auth-label">Nom *</label>
                            {{ form_widget(registrationForm.nom, {attr: {class: 'auth-input', placeholder: 'Dupont'}}) }}
                            {{ form_errors(registrationForm.nom) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="auth-label">Email *</label>
                        {{ form_widget(registrationForm.email, {attr: {class: 'auth-input', placeholder: 'marie@exemple.fr'}}) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="mb-3">
                        <label class="auth-label">Téléphone <span style="font-weight:400; text-transform:none;">(optionnel)</span></label>
                        {{ form_widget(registrationForm.telephone, {attr: {class: 'auth-input', placeholder: '+33 6 12 34 56 78'}}) }}
                        {{ form_errors(registrationForm.telephone) }}
                    </div>

                    <div class="mb-3">
                        <label class="auth-label">Mot de passe *</label>
                        <div class="input-group">
                            {{ form_widget(registrationForm.plainPassword.first, {attr: {class: 'auth-input', id: 'password1', style: 'border-radius: 6px 0 0 6px; border-right: none;'}}) }}
                            <button type="button" class="btn btn-outline-secondary toggle-password"
                                    data-target="password1"
                                    style="border: 1.5px solid #e5e7eb; border-left: none; border-radius: 0 6px 6px 0; background: white;">👁</button>
                        </div>
                        {{ form_errors(registrationForm.plainPassword.first) }}
                    </div>

                    <div class="mb-3">
                        <label class="auth-label">Confirmer le mot de passe *</label>
                        <div class="input-group">
                            {{ form_widget(registrationForm.plainPassword.second, {attr: {class: 'auth-input', id: 'password2', style: 'border-radius: 6px 0 0 6px; border-right: none;'}}) }}
                            <button type="button" class="btn btn-outline-secondary toggle-password"
                                    data-target="password2"
                                    style="border: 1.5px solid #e5e7eb; border-left: none; border-radius: 0 6px 6px 0; background: white;">👁</button>
                        </div>
                        {{ form_errors(registrationForm.plainPassword.second) }}
                    </div>

                    <div class="mb-4 d-flex align-items-center gap-2">
                        {{ form_widget(registrationForm.agreeTerms, {attr: {class: 'form-check-input', style: 'width:18px; height:18px; border: 1.5px solid #e5e7eb; cursor:pointer;'}}) }}
                        <label style="font-size:0.85rem; color:var(--gris); cursor:pointer;">
                            J'accepte les <a href="{{ path('app_front_cgv') }}" style="color:var(--rose);">conditions générales de vente</a>
                        </label>
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>

                    <button type="submit" class="btn btn-pink w-100" style="padding: 0.85rem; font-size: 0.95rem;">
                        Créer mon compte
                    </button>

                {{ form_end(registrationForm) }}

                <p class="text-center mt-4" style="font-size:0.85rem; color:var(--gris);">
                    Déjà un compte ? <a href="{{ path('app_login') }}" style="color: var(--rose); font-weight:600;">Se connecter</a>
                </p>
            </div>
        </div>
    </div>
</div>

<script>
document.querySelectorAll('.toggle-password').forEach(function(button) {
    button.addEventListener('click', function() {
        const input = this.closest('.input-group').querySelector('input');
        if (input.type === 'password') {
            input.type = 'text';
            this.textContent = '🙈';
        } else {
            input.type = 'password';
            this.textContent = '👁';
        }
    });
});
</script>
{% endblock %}