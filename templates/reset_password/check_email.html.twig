{% extends 'front/base.html.twig' %}

{% block title %}Email envoyé — Nice K'Cream Beauty{% endblock %}

{% block content %}
<div class="container py-5" style="background:#fafafa; min-height:80vh;">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div style="background:white; border-radius:16px; padding:2.5rem; box-shadow:0 4px 30px rgba(0,0,0,0.07); text-align:center;">
                <div style="width:64px; height:64px; background:var(--rose-pale); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--rose)" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <h1 style="font-family:var(--font-titre); font-size:1.6rem; color:var(--noir); margin-bottom:1rem;">Email envoyé !</h1>
                <p style="font-size:0.9rem; color:var(--gris); line-height:1.7; margin-bottom:1.5rem;">
                    Si un compte existe avec cette adresse email, vous recevrez dans quelques minutes un lien pour réinitialiser votre mot de passe.
                </p>
                <p style="font-size:0.82rem; color:var(--gris);">
                    Le lien expire dans <strong>1 heure</strong>. Pensez à vérifier vos spams.
                </p>
                <a href="{{ path('app_login') }}" class="btn btn-pink mt-3 px-4">
                    Retour à la connexion
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}